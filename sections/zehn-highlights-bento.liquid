{%- comment -%}
  ZEHN — Highlights bento grid
  Place in: sections/zehn-highlights-bento.liquid

  Self-contained: no Tailwind / theme utility classes required.
  Tile order = block order. Grid positions are fixed per position 1-6 so the
  bento shape is preserved regardless of which images or links are used.

  Desktop (>=768px), 4 cols x 8 rows:
    +---+---+-------+
    | 1 | 2 |   3   |
    | 1 +---+---+---+
    | 1 | 4 | 5 | 6 |
    +---+---+---+---+
  Mobile, 2 cols:
    | 1 | 2 |
    |   3   |
    |   4   |
{%- endcomment -%}

{%- liquid
  assign radius = section.settings.corner_radius
  assign gap = section.settings.grid_gap
  assign op = section.settings.overlay_opacity | divided_by: 100.0
  assign op_mid = op | times: 0.35
-%}

<style>
  #shopify-section-{{ section.id }} .zehn-bento-section {
    width: 100%;
    box-sizing: border-box;
    background: {{ section.settings.color_background }};
    padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
    padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
  }
  #shopify-section-{{ section.id }} .zehn-bento-inner {
    box-sizing: border-box;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
  }
  #shopify-section-{{ section.id }} .zehn-bento-head {
    text-align: center;
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .zehn-bento-eyebrow {
    display: block;
    margin: 0 0 12px;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: {{ section.settings.color_eyebrow }};
  }
  #shopify-section-{{ section.id }} .zehn-bento-heading {
    margin: 0;
    font-family: inherit;
    font-size: clamp(1.75rem, 4.2vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: {{ section.settings.color_heading }};
  }

  /* ---------- grid ---------- */
  #shopify-section-{{ section.id }} .zehn-bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(6, minmax(0, 1fr));
    gap: {{ gap }}px;
    height: {{ section.settings.grid_height_mobile }}px;
  }
  #shopify-section-{{ section.id }} .zehn-bento__tile--1 { grid-area: 1 / 1 / 3 / 2; }
  #shopify-section-{{ section.id }} .zehn-bento__tile--2 { grid-area: 1 / 2 / 3 / 3; }
  #shopify-section-{{ section.id }} .zehn-bento__tile--3 { grid-area: 3 / 1 / 5 / 3; }
  #shopify-section-{{ section.id }} .zehn-bento__tile--4 { grid-area: 5 / 1 / 7 / 3; }
  #shopify-section-{{ section.id }} .zehn-bento__tile--5,
  #shopify-section-{{ section.id }} .zehn-bento__tile--6 { display: none; }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .zehn-bento-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #shopify-section-{{ section.id }} .zehn-bento-inner {
      padding-left: 24px;
      padding-right: 24px;
    }
    #shopify-section-{{ section.id }} .zehn-bento-head { margin-bottom: 56px; }
    #shopify-section-{{ section.id }} .zehn-bento-eyebrow { font-size: 0.875rem; margin-bottom: 16px; }
    #shopify-section-{{ section.id }} .zehn-bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(8, minmax(0, 1fr));
      height: {{ section.settings.grid_height_desktop }}px;
    }
    #shopify-section-{{ section.id }} .zehn-bento__tile--1 { grid-area: 1 / 1 / 9 / 2; }
    #shopify-section-{{ section.id }} .zehn-bento__tile--2 { grid-area: 1 / 2 / 4 / 3; }
    #shopify-section-{{ section.id }} .zehn-bento__tile--3 { grid-area: 1 / 3 / 4 / 5; }
    #shopify-section-{{ section.id }} .zehn-bento__tile--4 { grid-area: 4 / 2 / 9 / 3; }
    #shopify-section-{{ section.id }} .zehn-bento__tile--5 { grid-area: 4 / 3 / 9 / 4; display: block; }
    #shopify-section-{{ section.id }} .zehn-bento__tile--6 { grid-area: 4 / 4 / 9 / 5; display: block; }
  }

  /* ---------- tile ---------- */
  #shopify-section-{{ section.id }} .zehn-bento__tile {
    position: relative;
    display: block;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    border-radius: {{ radius }}px;
    background: #f4f4f5;
    text-decoration: none;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  #shopify-section-{{ section.id }} .zehn-bento__img,
  #shopify-section-{{ section.id }} .zehn-bento__tile svg {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-width: none;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  {%- if section.settings.image_zoom -%}
  #shopify-section-{{ section.id }} .zehn-bento__tile:hover .zehn-bento__img,
  #shopify-section-{{ section.id }} .zehn-bento__tile:focus-visible .zehn-bento__img {
    transform: scale(1.05);
  }
  {%- endif -%}

  /* ---------- hover title ---------- */
  #shopify-section-{{ section.id }} .zehn-bento__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: {% if section.settings.title_position == 'center' %}center{% else %}flex-end{% endif %};
    justify-content: {% if section.settings.title_position == 'center' %}center{% else %}flex-start{% endif %};
    padding: 16px 20px;
    text-align: {% if section.settings.title_position == 'center' %}center{% else %}left{% endif %};
    pointer-events: none;
    opacity: 0;
    transition: opacity 350ms ease;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ op }}) 0%,
      rgba(0, 0, 0, {{ op_mid }}) 45%,
      rgba(0, 0, 0, 0) 100%
    );
  }
  #shopify-section-{{ section.id }} .zehn-bento__tile:hover .zehn-bento__overlay,
  #shopify-section-{{ section.id }} .zehn-bento__tile:focus-visible .zehn-bento__overlay {
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .zehn-bento__title {
    display: block;
    margin: 0;
    font-family: inherit;
    font-size: 1045rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #ffffff;
    transform: translateY(8px);
    transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #shopify-section-{{ section.id }} .zehn-bento__tile:hover .zehn-bento__title,
  #shopify-section-{{ section.id }} .zehn-bento__tile:focus-visible .zehn-bento__title {
    transform: translateY(0);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .zehn-bento__title { font-size: 1.4rem; }
  }
  {%- if section.settings.title_always_touch -%}
  @media (hover: none) {
    #shopify-section-{{ section.id }} .zehn-bento__overlay { opacity: 1; }
    #shopify-section-{{ section.id }} .zehn-bento__title { transform: translateY(0); }
  }
  {%- endif -%}
  {%- if section.settings.title_reveal == 'always' -%}
  #shopify-section-{{ section.id }} .zehn-bento__overlay { opacity: 1; }
  #shopify-section-{{ section.id }} .zehn-bento__title { transform: translateY(0); }
  {%- endif -%}

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .zehn-bento__img,
    #shopify-section-{{ section.id }} .zehn-bento__overlay,
    #shopify-section-{{ section.id }} .zehn-bento__title {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<div class="zehn-bento-section">
  <div class="zehn-bento-inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="zehn-bento-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="zehn-bento-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="zehn-bento-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign fallback_assets = 'bento-new-arrivals.jpg,bento-premium.jpg,bento-style-guide.jpg,bento-sale.jpg,bento-bestsellers.jpg,bento-collections.jpg' | split: ',' -%}
    <div class="zehn-bento">
      {%- for block in section.blocks limit: 6 -%}
        {%- liquid
          assign i = forloop.index
          assign tile_title = block.settings.title
          if tile_title == blank
            assign tile_title = block.settings.image.alt
          endif
        -%}

        {%- if block.settings.link != blank -%}
          <a
            class="zehn-bento__tile zehn-bento__tile--{{ i }}"
            href="{{ block.settings.link }}"
            {% if tile_title != blank %}aria-label="{{ tile_title | escape }}"{% endif %}
            {{ block.shopify_attributes }}
          >
        {%- else -%}
          <div class="zehn-bento__tile zehn-bento__tile--{{ i }}" {{ block.shopify_attributes }}>
        {%- endif -%}

          {%- if block.settings.image != blank -%}
            <img
              class="zehn-bento__img"
              src="{{ block.settings.image | image_url: width: 1200 }}"
              srcset="
                {{ block.settings.image | image_url: width: 400 }} 400w,
                {{ block.settings.image | image_url: width: 600 }} 600w,
                {{ block.settings.image | image_url: width: 800 }} 800w,
                {{ block.settings.image | image_url: width: 1200 }} 1200w,
                {{ block.settings.image | image_url: width: 1600 }} 1600w
              "
              sizes="(min-width: 768px) 33vw, 100vw"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              alt="{{ tile_title | escape }}"
              loading="lazy"
              decoding="async"
              style="object-position: {{ block.settings.focal_point }};"
            >
          {%- else -%}
            <img
              class="zehn-bento__img"
              src="{{ fallback_assets[forloop.index0] | asset_url }}"
              width="1200"
              height="800"
              alt="{{ tile_title | escape }}"
              loading="lazy"
              decoding="async"
              style="object-position: {{ block.settings.focal_point }};"
            >
          {%- endif -%}

          {%- if tile_title != blank -%}
            <div class="zehn-bento__overlay">
              <span class="zehn-bento__title">{{ tile_title }}</span>
            </div>
          {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Highlights bento",
  "tag": "section",
  "class": "zehn-highlights-bento",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HIGHLIGHTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Entdecke die Welt von ZEHN" },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "range",
      "id": "grid_height_desktop",
      "label": "Grid height (desktop)",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "grid_height_mobile",
      "label": "Grid height (mobile)",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between tiles",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Section background", "default": "#f7f7f8" },
    { "type": "color", "id": "color_heading", "label": "Heading", "default": "#0f172a" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow", "default": "#71717a" },
    { "type": "header", "content": "Hover title" },
    {
      "type": "select",
      "id": "title_reveal",
      "label": "Show title",
      "options": [
        { "value": "hover", "label": "On hover" },
        { "value": "always", "label": "Always" }
      ],
      "default": "hover"
    },
    {
      "type": "checkbox",
      "id": "title_always_touch",
      "label": "Always show on touch devices",
      "info": "Touch devices have no hover state.",
      "default": true
    },
    {
      "type": "select",
      "id": "title_position",
      "label": "Title position",
      "options": [
        { "value": "bottom", "label": "Bottom left" },
        { "value": "center", "label": "Centered" }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    { "type": "checkbox", "id": "image_zoom", "label": "Zoom image on hover", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "info": "Shown over the image on hover." },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "focal_point",
          "label": "Image focal point",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Highlights bento",
      "blocks": [
        { "type": "tile", "settings": { "title": "Neuheiten", "link": "/collections/neuheiten" } },
        { "type": "tile", "settings": { "title": "Premium", "link": "/pages/about" } },
        { "type": "tile", "settings": { "title": "Style Guide", "link": "/pages/fitguide" } },
        { "type": "tile", "settings": { "title": "Sale", "link": "/collections/sale" } },
        { "type": "tile", "settings": { "title": "Bestseller", "link": "/collections/bestseller" } },
        { "type": "tile", "settings": { "title": "Collections", "link": "/collections/all" } }
      ]
    }
  ]
}
{% endschema %}
