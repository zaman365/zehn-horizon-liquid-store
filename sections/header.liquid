{%- comment -%}
  ============================================================================
  ZEHN header — Liquid port of components/zehn/Header.tsx

  Floating glass navbar that sits under the announcement bar, with:
    - desktop link row (left), centred logo, action icons (right)
    - hover/focus mega dropdown, centred under the hovered link
    - mobile hamburger drawer with per-collection accordions
    - cart + wishlist count badges, logged-in dot on the account icon

  Install: sections/header.liquid
  Add it to the "header" section group, directly below announcement-bar.

  Menu mapping (see notes at the end of this file):
    level 1 -> top nav links          e.g. Shop All / NEUHEITEN / Sale
    level 2 -> dropdown accordions    e.g. Oberteile / Hosen
    level 3 -> links inside accordion e.g. Oversize / Longsleeve

  Buttons dispatch events instead of rendering the drawers themselves:
    zehn:cart:open      -> cart drawer section listens
    zehn:search:open    -> search modal section listens
  If nothing listens, the buttons fall back to /cart and /search.

  Exposes: --zehn-navbar-height, --zehn-header-stack
  Use --zehn-header-stack in homepage-hero.css instead of the hard-coded
  --site-header-stack-mobile / -desktop constants.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign menu = linklists[section.settings.menu]
  assign nav_h = section.settings.navbar_height
  assign gap = section.settings.announcement_gap
  assign accent = section.settings.accent_color
  assign fg = section.settings.text_color
-%}

{%- capture icon_menu -%}
  <svg class="zh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
{%- endcapture -%}
{%- capture icon_close -%}
  <svg class="zh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
{%- endcapture -%}
{%- capture icon_search -%}
  <svg class="zh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
{%- endcapture -%}
{%- capture icon_user -%}
  <svg class="zh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
{%- endcapture -%}
{%- capture icon_heart -%}
  <svg class="zh-icon zh-icon--heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
{%- endcapture -%}
{%- capture icon_bag -%}
  <svg class="zh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
{%- endcapture -%}
{%- capture icon_chevron -%}
  <svg class="zh-icon zh-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
{%- endcapture -%}

{%- style -%}
  :root {
    --zehn-navbar-height: {{ nav_h }}px;
    /* announcement height + breathing gap + navbar + trailing gap */
    --zehn-header-stack: calc(
      var(--announcement-bar-height, 0px) + {{ gap }}px + {{ nav_h }}px + 5px
    );
  }

  #ZehnHeader-{{ section.id }} {
    --zh-fg: {{ fg }};
    --zh-accent: {{ accent }};
    --zh-accent-fg: {{ section.settings.accent_foreground }};
    --zh-fg-80: {{ fg | color_modify: 'alpha', 0.8 }};
    --zh-fg-70: {{ fg | color_modify: 'alpha', 0.7 }};
    --zh-fg-60: {{ fg | color_modify: 'alpha', 0.6 }};
    --zh-fg-10: {{ fg | color_modify: 'alpha', 0.1 }};
    --zh-fg-05: {{ fg | color_modify: 'alpha', 0.05 }};
    --zh-card: rgba(255, 255, 255, {{ section.settings.card_opacity | divided_by: 100.0 }});
    --zh-panel: rgba(255, 255, 255, 0.95);
    --zh-border: rgba(255, 255, 255, 0.3);
    --zh-blur: {{ section.settings.blur }}px;
    --zh-radius: 8px;
    --zh-radius-lg: 16px;
    --zh-shadow: {{ fg | color_modify: 'alpha', 0.12 }} 0 10px 50px;
    --zh-ease: cubic-bezier(0, 0, 0.2, 1);
    --zh-t: 400ms;

    position: fixed;
    top: calc(var(--announcement-bar-height, 0px) + {{ gap }}px);
    left: 0;
    right: 0;
    z-index: {{ section.settings.z_index }};
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    background: transparent;
  }

  /* ---------- floating card ---------- */
  #ZehnHeader-{{ section.id }} .zh-nav {
    position: relative;
    width: 97.5%;
    margin: 0 auto;
    padding: 0 8px;
    border: 1px solid var(--zh-border);
    border-radius: var(--zh-radius);
    background-color: var(--zh-card);
    -webkit-backdrop-filter: blur(var(--zh-blur));
    backdrop-filter: blur(var(--zh-blur));
    box-shadow: var(--zh-shadow);
    box-sizing: border-box;
  }

  {%- if section.settings.enable_entrance -%}
    @keyframes zh-enter-{{ section.id }} {
      from { opacity: 0; transform: translateY(-8px) scale(0.95); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    #ZehnHeader-{{ section.id }} .zh-nav {
      animation: zh-enter-{{ section.id }} 600ms var(--zh-ease) 10ms both;
    }
  {%- endif -%}

  #ZehnHeader-{{ section.id }} .zh-row {
    display: flex;
    align-items: center;
    height: {{ nav_h }}px;
  }

  /* ---------- icon buttons ---------- */
  #ZehnHeader-{{ section.id }} .zh-icon {
    width: 18px;
    height: 18px;
    display: block;
    flex-shrink: 0;
  }

  #ZehnHeader-{{ section.id }} .zh-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 36px;
    padding: 6px;
    border: 0;
    background: none;
    color: var(--zh-fg-70);
    cursor: pointer;
    transition: color var(--zh-t) var(--zh-ease);
    -webkit-appearance: none;
    appearance: none;
    text-decoration: none;
  }

  #ZehnHeader-{{ section.id }} .zh-btn:hover,
  #ZehnHeader-{{ section.id }} .zh-btn:focus-visible {
    color: var(--zh-fg);
    text-decoration: none;
  }

  #ZehnHeader-{{ section.id }} .zh-btn--tap {
    min-width: 44px;
    min-height: 44px;
    padding: 8px;
  }

  #ZehnHeader-{{ section.id }} .zh-btn:focus-visible,
  #ZehnHeader-{{ section.id }} .zh-link:focus-visible,
  #ZehnHeader-{{ section.id }} .zh-acc__toggle:focus-visible {
    outline: 2px solid var(--zh-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  #ZehnHeader-{{ section.id }} .zh-badge-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---------- count badges ---------- */
  #ZehnHeader-{{ section.id }} .zh-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: var(--zh-accent);
    color: var(--zh-accent-fg);
    font-size: 8px;
    font-weight: 500;
    line-height: 12px;
    letter-spacing: 0;
    text-align: center;
  }

  #ZehnHeader-{{ section.id }} [data-zh-count='0'] .zh-badge,
  #ZehnHeader-{{ section.id }} [data-zh-count='0'] .zh-dot {
    display: none;
  }

  #ZehnHeader-{{ section.id }} [data-zh-count]:not([data-zh-count='0']) .zh-icon {
    color: var(--zh-accent);
  }

  #ZehnHeader-{{ section.id }} [data-zh-count]:not([data-zh-count='0']) .zh-icon--heart {
    fill: var(--zh-accent);
    stroke: var(--zh-accent);
  }

  #ZehnHeader-{{ section.id }} .zh-account-dot {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--zh-accent);
  }

  #ZehnHeader-{{ section.id }} .zh-burger__dot {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: var(--zh-accent);
  }

  #ZehnHeader-{{ section.id }} .zh-burger[aria-expanded='true'] .zh-burger__dot,
  #ZehnHeader-{{ section.id }} .zh-burger[aria-expanded='true'] .zh-burger__open,
  #ZehnHeader-{{ section.id }} .zh-burger[aria-expanded='false'] .zh-burger__close {
    display: none;
  }

  /* ---------- logo ---------- */
  #ZehnHeader-{{ section.id }} .zh-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: block;
    line-height: 0;
  }

  #ZehnHeader-{{ section.id }} .zh-logo img,
  #ZehnHeader-{{ section.id }} .zh-logo svg {
    height: {{ section.settings.logo_height_mobile }}px;
    width: auto;
    border: 0;
    border-radius: 0;
    outline: none;
    display: block;
  }

  #ZehnHeader-{{ section.id }} .zh-logo-text {
    font-family: var(--font-display, 'Archivo', system-ui, sans-serif);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--zh-fg);
    text-decoration: none;
  }

  #ZehnHeader-{{ section.id }} .zh-spacer {
    flex-grow: 1;
  }

  #ZehnHeader-{{ section.id }} .zh-actions {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  /* ---------- desktop link row ---------- */
  #ZehnHeader-{{ section.id }} .zh-desktop-links {
    display: none;
    align-items: center;
    gap: 24px;
  }

  #ZehnHeader-{{ section.id }} .zh-link {
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--zh-fg-70);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--zh-t) var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} .zh-link:hover,
  #ZehnHeader-{{ section.id }} .zh-link:focus,
  #ZehnHeader-{{ section.id }} .zh-link[aria-expanded='true'] {
    color: var(--zh-accent);
    text-decoration: none;
  }

  #ZehnHeader-{{ section.id }} .zh-only-mobile { display: flex; }
  #ZehnHeader-{{ section.id }} .zh-only-desktop { display: none; }

  /* ---------- dropdown ---------- */
  #ZehnHeader-{{ section.id }} .zh-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: -moz-fit-content;
    width: fit-content;
    max-width: calc(100% - 2rem);
    margin-top: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      max-height var(--zh-t) var(--zh-ease),
      margin-top var(--zh-t) var(--zh-ease),
      opacity var(--zh-t) var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} .zh-dropdown.is-open {
    margin-top: 12px;
    max-height: 75vh;
    overflow-y: auto;
    opacity: 1;
    pointer-events: auto;
  }

  #ZehnHeader-{{ section.id }} .zh-dropdown__card {
    width: -moz-max-content;
    width: max-content;
    max-width: 100%;
    padding: 32px;
    border-radius: var(--zh-radius-lg);
    background: var(--zh-panel);
  }

  #ZehnHeader-{{ section.id }} .zh-panel {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: -moz-max-content;
    width: max-content;
    max-width: 100%;
  }

  #ZehnHeader-{{ section.id }} .zh-panel.is-active { display: flex; }

  /* ---------- accordions (shared desktop + mobile) ---------- */
  #ZehnHeader-{{ section.id }} .zh-acc { padding: 5px 0; }
  #ZehnHeader-{{ section.id }} .zh-acc:first-child { padding-top: 0; }
  #ZehnHeader-{{ section.id }} .zh-acc:last-child { padding-bottom: 0; }

  #ZehnHeader-{{ section.id }} .zh-acc__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 36px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--zh-fg);
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-align: left;
    cursor: pointer;
    transition: color var(--zh-t) var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} .zh-acc__toggle:hover { color: var(--zh-accent); }

  #ZehnHeader-{{ section.id }} .zh-acc__toggle[aria-expanded='true'] {
    color: var(--zh-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  #ZehnHeader-{{ section.id }} .zh-chevron {
    width: 16px;
    height: 16px;
    transition: transform 300ms var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} [aria-expanded='true'] .zh-chevron {
    transform: rotate(180deg);
  }

  #ZehnHeader-{{ section.id }} .zh-acc__body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 300ms var(--zh-ease),
      opacity 300ms var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} .zh-acc__body.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  #ZehnHeader-{{ section.id }} .zh-acc__clip {
    min-height: 0;
    overflow: hidden;
  }

  #ZehnHeader-{{ section.id }} .zh-acc__list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
    padding-left: 12px;
    border-left: 1px solid var(--zh-fg-10);
  }

  #ZehnHeader-{{ section.id }} .zh-sublink {
    display: block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--zh-fg-60);
    text-decoration: none;
    transition: color var(--zh-t) var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} .zh-sublink--all { color: var(--zh-fg-80); }

  #ZehnHeader-{{ section.id }} .zh-sublink:hover {
    color: var(--zh-fg);
    text-decoration: none;
  }

  /* ---------- mobile drawer ---------- */
  #ZehnHeader-{{ section.id }} .zh-mobile {
    overflow: hidden;
    max-height: 0;
    transition: max-height var(--zh-t) var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} .zh-mobile.is-open {
    max-height: 75vh;
    overflow-y: auto;
    padding-bottom: 16px;
  }

  #ZehnHeader-{{ section.id }} .zh-mobile__inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
    border-top: 1px solid var(--zh-fg-10);
    border-radius: var(--zh-radius-lg);
    background: var(--zh-panel);
  }

  #ZehnHeader-{{ section.id }} .zh-mobile__row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #ZehnHeader-{{ section.id }} .zh-mobile__link {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--zh-fg-70);
    text-decoration: none;
    transition: color var(--zh-t) var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} .zh-mobile__link:hover {
    color: var(--zh-fg);
    text-decoration: none;
  }

  #ZehnHeader-{{ section.id }} .zh-mobile__toggle {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--zh-fg-10);
    border-radius: 9999px;
    background: none;
    color: var(--zh-fg-60);
    cursor: pointer;
    transition: background-color 300ms var(--zh-ease), color 300ms var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} .zh-mobile__toggle[aria-expanded='true'] {
    background: var(--zh-fg-05);
    color: var(--zh-fg);
  }

  #ZehnHeader-{{ section.id }} .zh-mobile__sub { padding-left: 0; margin-top: 8px; }
  #ZehnHeader-{{ section.id }} .zh-mobile__sub .zh-panel { display: flex; gap: 4px; }

  #ZehnHeader-{{ section.id }} .zh-mobile__action {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 0;
    border: 0;
    background: none;
    color: var(--zh-fg-70);
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--zh-t) var(--zh-ease);
  }

  #ZehnHeader-{{ section.id }} .zh-mobile__action:hover {
    color: var(--zh-fg);
    text-decoration: none;
  }

  #ZehnHeader-{{ section.id }} .zh-mobile__action .zh-badge-wrap { margin-right: 12px; }
  #ZehnHeader-{{ section.id }} .zh-mobile__action .zh-icon { width: 16px; height: 16px; }

  /* ---------- breakpoints ---------- */
  @media (min-width: 640px) {
    #ZehnHeader-{{ section.id }} .zh-nav { padding: 0 20px; }
    #ZehnHeader-{{ section.id }} .zh-icon { width: 20px; height: 20px; }
    #ZehnHeader-{{ section.id }} .zh-btn { min-width: 44px; min-height: 44px; padding: 8px; }
    #ZehnHeader-{{ section.id }} .zh-actions { gap: 4px; }
    #ZehnHeader-{{ section.id }} .zh-logo img,
    #ZehnHeader-{{ section.id }} .zh-logo svg { height: {{ section.settings.logo_height_mobile }}px; }
  }

  @media (min-width: 1024px) {
    :root {
      --zehn-header-stack: calc(
        var(--announcement-bar-height, 0px) + {{ gap }}px + {{ nav_h }}px + 6px
      );
    }

    #ZehnHeader-{{ section.id }} .zh-nav {
      width: min(95vw, 1400px);
      max-width: 1400px;
      padding: 0 32px;
    }

    #ZehnHeader-{{ section.id }} .zh-desktop-links { display: flex; }
    #ZehnHeader-{{ section.id }} .zh-dropdown { display: block; }
    #ZehnHeader-{{ section.id }} .zh-actions { gap: 16px; }
    #ZehnHeader-{{ section.id }} .zh-only-mobile { display: none; }
    #ZehnHeader-{{ section.id }} .zh-only-desktop { display: flex; }
    #ZehnHeader-{{ section.id }} .zh-mobile { display: none; }

    #ZehnHeader-{{ section.id }} .zh-logo img,
    #ZehnHeader-{{ section.id }} .zh-logo svg {
      height: {{ section.settings.logo_height_desktop }}px;
    }
  }

  @media (min-width: 1280px) {
    #ZehnHeader-{{ section.id }} .zh-desktop-links { gap: 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZehnHeader-{{ section.id }} .zh-nav { animation: none; }
    #ZehnHeader-{{ section.id }} * { transition-duration: 1ms !important; }
  }
{%- endstyle -%}

<header
  id="ZehnHeader-{{ section.id }}"
  class="zehn-header"
  data-zehn-header
>
  <nav class="zh-nav" data-zh-nav aria-label="{{ section.settings.nav_label | escape }}">
    <div class="zh-row">
      {%- comment -%} Mobile: hamburger {%- endcomment -%}
      <button
        type="button"
        class="zh-btn zh-btn--tap zh-burger zh-only-mobile"
        data-zh-menu-toggle
        aria-expanded="false"
        aria-controls="ZehnMobileMenu-{{ section.id }}"
        aria-label="{{ 'Menü öffnen' | escape }}"
        data-label-open="{{ 'Menü öffnen' | escape }}"
        data-label-close="{{ 'Menü schließen' | escape }}"
      >
        <span class="zh-burger__open">{{ icon_menu }}</span>
        <span class="zh-burger__close">{{ icon_close }}</span>
        <span class="zh-burger__dot" data-zh-wishlist-dot hidden></span>
      </button>

      {%- comment -%} Mobile: search {%- endcomment -%}
      <button
        type="button"
        class="zh-btn zh-btn--tap zh-only-mobile"
        data-zh-search
        aria-label="{{ 'Suche' | escape }}"
      >
        {{ icon_search }}
      </button>

      {%- comment -%} Desktop: link row {%- endcomment -%}
      <div class="zh-desktop-links" data-zh-desktop-links>
        {%- for link in menu.links -%}
          {%- assign has_children = false -%}
          {%- if link.links.size > 0 -%}{%- assign has_children = true -%}{%- endif -%}
          <a
            class="zh-link"
            href="{{ link.url }}"
            data-zh-trigger="{{ forloop.index }}"
            {% if has_children %}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="ZehnPanel-{{ section.id }}-{{ forloop.index }}"
            {% endif %}
          >
            {{ link.title }}
          </a>
        {%- endfor -%}
      </div>

      {%- comment -%} Centred logo {%- endcomment -%}
      <a class="zh-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: height: 200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              alt: shop.name,
              translate: 'no',
              decoding: 'async'
          }}
        {%- else -%}
          <span class="zh-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <div class="zh-spacer"></div>

      {%- comment -%} Right: action icons {%- endcomment -%}
      <div class="zh-actions">
        <button
          type="button"
          class="zh-btn zh-btn--tap zh-only-desktop"
          data-zh-search
          aria-label="{{ 'Suche' | escape }}"
        >
          {{ icon_search }}
        </button>

        <a
          class="zh-btn zh-btn--tap"
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          aria-label="{% if customer %}{{ 'Mein Konto' | escape }}{% else %}{{ 'Anmelden' | escape }}{% endif %}"
          title="{% if customer %}{{ 'Mein Konto' | escape }}{% else %}{{ 'Anmelden' | escape }}{% endif %}"
        >
          {{ icon_user }}
          {%- if customer -%}<span class="zh-account-dot" aria-hidden="true"></span>{%- endif -%}
        </a>

        {%- if section.settings.wishlist_url != blank -%}
          <a
            class="zh-btn zh-only-desktop"
            href="{{ section.settings.wishlist_url }}"
            aria-label="{{ 'Wunschliste' | escape }}"
            title="{{ 'Wunschliste' | escape }}"
            data-zh-wishlist
            data-zh-count="0"
          >
            <span class="zh-badge-wrap">
              {{ icon_heart }}
              <span class="zh-badge" data-zh-wishlist-count>0</span>
            </span>
          </a>
        {%- endif -%}

        <button
          type="button"
          class="zh-btn"
          data-zh-cart
          data-zh-count="{{ cart.item_count }}"
          aria-label="{{ 'Warenkorb' | escape }}"
        >
          <span class="zh-badge-wrap">
            {{ icon_bag }}
            <span class="zh-badge" data-zh-cart-count>
              {%- if cart.item_count > 9 -%}9+{%- else -%}{{ cart.item_count }}{%- endif -%}
            </span>
          </span>
        </button>
      </div>
    </div>

    {%- comment -%} ---------- Desktop dropdown ---------- {%- endcomment -%}
    <div class="zh-dropdown" data-zh-dropdown aria-hidden="true">
      <div class="zh-dropdown__card" data-zh-dropdown-card>
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <div
              class="zh-panel"
              id="ZehnPanel-{{ section.id }}-{{ forloop.index }}"
              data-zh-panel="{{ forloop.index }}"
              role="group"
              aria-label="{{ link.title | escape }}"
            >
              {%- for child in link.links -%}
                {%- assign acc_id = 'ZehnAcc-' | append: section.id | append: '-d' | append: forloop.parentloop.index | append: '-' | append: forloop.index -%}
                <div class="zh-acc">
                  {%- if child.links.size > 0 -%}
                    <button
                      type="button"
                      class="zh-acc__toggle"
                      data-zh-acc-toggle
                      data-zh-group="d{{ forloop.parentloop.index }}"
                      aria-expanded="false"
                      aria-controls="{{ acc_id }}"
                    >
                      <span>{{ child.title }}</span>
                      {{ icon_chevron }}
                    </button>
                    <div class="zh-acc__body" id="{{ acc_id }}" data-zh-acc-body>
                      <div class="zh-acc__clip">
                        <div class="zh-acc__list">
                          <a class="zh-sublink zh-sublink--all" href="{{ child.url }}">
                            {{ section.settings.all_prefix }} {{ child.title }}
                          </a>
                          {%- for grandchild in child.links -%}
                            <a class="zh-sublink" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                          {%- endfor -%}
                        </div>
                      </div>
                    </div>
                  {%- else -%}
                    <a class="zh-acc__toggle" href="{{ child.url }}">
                      <span>{{ child.title }}</span>
                    </a>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---------- Mobile drawer ---------- {%- endcomment -%}
    <div class="zh-mobile" id="ZehnMobileMenu-{{ section.id }}" data-zh-mobile>
      <div class="zh-mobile__inner" data-zh-mobile-inner>
        {%- for link in menu.links -%}
          {%- assign m_id = 'ZehnMobileSub-' | append: section.id | append: '-' | append: forloop.index -%}
          <div>
            <div class="zh-mobile__row">
              <a class="zh-mobile__link" href="{{ link.url }}" data-zh-close-menu>
                {{ link.title }}
              </a>
              {%- if link.links.size > 0 -%}
                <button
                  type="button"
                  class="zh-mobile__toggle"
                  data-zh-acc-toggle
                  data-zh-group="m-top"
                  aria-expanded="false"
                  aria-controls="{{ m_id }}"
                  aria-label="{{ 'Unterkategorien anzeigen' | escape }}: {{ link.title | escape }}"
                  data-label-open="{{ 'Unterkategorien anzeigen' | escape }}: {{ link.title | escape }}"
                  data-label-close="{{ 'Unterkategorien ausblenden' | escape }}: {{ link.title | escape }}"
                >
                  {{ icon_chevron }}
                </button>
              {%- endif -%}
            </div>

            {%- if link.links.size > 0 -%}
              <div class="zh-acc__body" id="{{ m_id }}" data-zh-acc-body>
                <div class="zh-acc__clip">
                  <div class="zh-mobile__sub">
                    <div class="zh-panel">
                      {%- for child in link.links -%}
                        {%- assign sub_id = 'ZehnAcc-' | append: section.id | append: '-m' | append: forloop.parentloop.index | append: '-' | append: forloop.index -%}
                        <div class="zh-acc">
                          {%- if child.links.size > 0 -%}
                            <button
                              type="button"
                              class="zh-acc__toggle"
                              data-zh-acc-toggle
                              data-zh-group="m{{ forloop.parentloop.index }}"
                              aria-expanded="false"
                              aria-controls="{{ sub_id }}"
                            >
                              <span>{{ child.title }}</span>
                              {{ icon_chevron }}
                            </button>
                            <div class="zh-acc__body" id="{{ sub_id }}" data-zh-acc-body>
                              <div class="zh-acc__clip">
                                <div class="zh-acc__list">
                                  <a class="zh-sublink zh-sublink--all" href="{{ child.url }}" data-zh-close-menu>
                                    {{ section.settings.all_prefix }} {{ child.title }}
                                  </a>
                                  {%- for grandchild in child.links -%}
                                    <a class="zh-sublink" href="{{ grandchild.url }}" data-zh-close-menu>
                                      {{ grandchild.title }}
                                    </a>
                                  {%- endfor -%}
                                </div>
                              </div>
                            </div>
                          {%- else -%}
                            <a class="zh-acc__toggle" href="{{ child.url }}" data-zh-close-menu>
                              <span>{{ child.title }}</span>
                            </a>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.settings.wishlist_url != blank -%}
          <a
            class="zh-mobile__action"
            href="{{ section.settings.wishlist_url }}"
            data-zh-close-menu
            data-zh-wishlist
            data-zh-count="0"
          >
            <span class="zh-badge-wrap">
              {{ icon_heart }}
              <span class="zh-badge" data-zh-wishlist-count>0</span>
            </span>
            {{ section.settings.wishlist_label }}
          </a>
        {%- endif -%}

        <button
          type="button"
          class="zh-mobile__action"
          data-zh-cart
          data-zh-count="{{ cart.item_count }}"
        >
          <span class="zh-badge-wrap">
            {{ icon_bag }}
            <span class="zh-badge" data-zh-cart-count>
              {%- if cart.item_count > 9 -%}9+{%- else -%}{{ cart.item_count }}{%- endif -%}
            </span>
          </span>
          {{ section.settings.cart_label }}
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  (function () {
    var root = document.getElementById('ZehnHeader-{{ section.id }}');
    if (!root) return;

    window.__zehnHeaders = window.__zehnHeaders || {};
    if (window.__zehnHeaders['{{ section.id }}']) {
      window.__zehnHeaders['{{ section.id }}']();
    }

    var nav = root.querySelector('[data-zh-nav]');
    var burger = root.querySelector('[data-zh-menu-toggle]');
    var mobile = root.querySelector('[data-zh-mobile]');
    var mobileInner = root.querySelector('[data-zh-mobile-inner]');
    var dropdown = root.querySelector('[data-zh-dropdown]');
    var linkRow = root.querySelector('[data-zh-desktop-links]');
    var triggers = root.querySelectorAll('[data-zh-trigger]');
    var panels = root.querySelectorAll('[data-zh-panel]');

    var closeDelay = {{ section.settings.close_delay }};
    var closeTimer = null;
    var activePanel = null;

    /* ---------- accordions ---------- */
    function setAccordion(toggle, open) {
      var body = document.getElementById(toggle.getAttribute('aria-controls'));
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (body) body.classList.toggle('is-open', open);
      if (toggle.dataset.labelOpen) {
        toggle.setAttribute(
          'aria-label',
          open ? toggle.dataset.labelClose : toggle.dataset.labelOpen,
        );
      }
    }

    function closeAccordionsIn(scope) {
      if (!scope) return;
      scope.querySelectorAll('[data-zh-acc-toggle][aria-expanded="true"]').forEach(function (t) {
        setAccordion(t, false);
      });
    }

    root.addEventListener('click', function (event) {
      var toggle = event.target.closest('[data-zh-acc-toggle]');
      if (!toggle || !root.contains(toggle)) return;

      event.preventDefault();
      var isOpen = toggle.getAttribute('aria-expanded') === 'true';

      // One open sibling per group, matching the single-value React state.
      var group = toggle.getAttribute('data-zh-group');
      if (group && !isOpen) {
        root
          .querySelectorAll('[data-zh-group="' + group + '"][aria-expanded="true"]')
          .forEach(function (t) {
            if (t !== toggle) setAccordion(t, false);
          });
      }

      setAccordion(toggle, !isOpen);
    });

    /* ---------- desktop dropdown ---------- */
    function cancelClose() {
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = null;
    }

    function closeDropdown() {
      cancelClose();
      if (!dropdown) return;
      dropdown.classList.remove('is-open');
      dropdown.setAttribute('aria-hidden', 'true');
      dropdown.style.left = '0';
      dropdown.style.transform = 'none';
      closeAccordionsIn(dropdown);
      panels.forEach(function (p) {
        p.classList.remove('is-active');
      });
      triggers.forEach(function (t) {
        if (t.hasAttribute('aria-expanded')) t.setAttribute('aria-expanded', 'false');
      });
      activePanel = null;
    }

    function scheduleClose() {
      cancelClose();
      closeTimer = setTimeout(closeDropdown, closeDelay);
    }

    function openDropdown(trigger) {
      if (!dropdown) return;
      var key = trigger.getAttribute('data-zh-trigger');
      var panel = root.querySelector('[data-zh-panel="' + key + '"]');
      if (!panel) {
        closeDropdown();
        return;
      }

      cancelClose();

      if (activePanel !== panel) {
        closeAccordionsIn(dropdown);
        panels.forEach(function (p) {
          p.classList.toggle('is-active', p === panel);
        });
        triggers.forEach(function (t) {
          if (t.hasAttribute('aria-expanded')) {
            t.setAttribute('aria-expanded', t === trigger ? 'true' : 'false');
          }
        });
        activePanel = panel;
      }

      dropdown.classList.add('is-open');
      dropdown.setAttribute('aria-hidden', 'false');

      // Centre the panel under the hovered link.
      var navRect = nav.getBoundingClientRect();
      var itemRect = trigger.getBoundingClientRect();
      dropdown.style.left = itemRect.left + itemRect.width / 2 - navRect.left + 'px';
      dropdown.style.transform = 'translateX(-50%)';
    }

    triggers.forEach(function (trigger) {
      trigger.addEventListener('mouseenter', function () {
        openDropdown(trigger);
      });
      trigger.addEventListener('focus', function () {
        openDropdown(trigger);
      });
      trigger.addEventListener('click', closeDropdown);
    });

    if (linkRow) {
      linkRow.addEventListener('mouseenter', cancelClose);
      linkRow.addEventListener('mouseleave', scheduleClose);
    }

    if (dropdown) {
      dropdown.addEventListener('mouseenter', cancelClose);
      dropdown.addEventListener('mouseleave', scheduleClose);
    }

    /* ---------- mobile drawer ---------- */
    function setMenu(open) {
      if (!burger || !mobile) return;
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute(
        'aria-label',
        open ? burger.dataset.labelClose : burger.dataset.labelOpen,
      );
      mobile.classList.toggle('is-open', open);
      if (!open) closeAccordionsIn(mobileInner);
    }

    if (burger) {
      burger.addEventListener('click', function () {
        setMenu(burger.getAttribute('aria-expanded') !== 'true');
      });
    }

    root.querySelectorAll('[data-zh-close-menu]').forEach(function (el) {
      el.addEventListener('click', function () {
        setMenu(false);
      });
    });

    /* ---------- outside click + escape ---------- */
    function onPointerDown(event) {
      var target = event.target;
      if (dropdown && dropdown.classList.contains('is-open')) {
        var inRow = linkRow && linkRow.contains(target);
        if (!dropdown.contains(target) && !inRow) closeDropdown();
      }
      if (mobile && mobile.classList.contains('is-open')) {
        var onBurger = burger && burger.contains(target);
        if (!mobile.contains(target) && !onBurger) setMenu(false);
      }
    }

    function onKeyDown(event) {
      if (event.key !== 'Escape') return;
      closeDropdown();
      setMenu(false);
    }

    document.addEventListener('mousedown', onPointerDown);
    document.addEventListener('touchstart', onPointerDown, {passive: true});
    document.addEventListener('keydown', onKeyDown);

    /* ---------- search + cart triggers ---------- */
    // If the drawer/modal section is on the page it gets the event.
    // If it isn't installed yet, go to the normal page instead.
    function openOverlay(selector, eventName, fallbackUrl) {
      if (document.querySelector(selector)) {
        document.dispatchEvent(new CustomEvent(eventName, {bubbles: true}));
      } else {
        window.location.href = fallbackUrl;
      }
    }

    root.querySelectorAll('[data-zh-search]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        setMenu(false);
        openOverlay('[data-zehn-search-modal]', 'zehn:search:open', {{ routes.search_url | json }});
      });
    });

    root.querySelectorAll('[data-zh-cart]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        setMenu(false);
        openOverlay('[data-zehn-cart-drawer]', 'zehn:cart:open', {{ routes.cart_url | json }});
      });
    });

    /* ---------- counts ---------- */
    function paint(selector, countEl, count) {
      root.querySelectorAll(selector).forEach(function (el) {
        el.setAttribute('data-zh-count', String(count));
        var badge = el.querySelector(countEl);
        if (badge) badge.textContent = count > 9 ? '9+' : String(count);
      });
    }

    function setCartCount(count) {
      paint('[data-zh-cart]', '[data-zh-cart-count]', Number(count) || 0);
    }

    function readWishlist() {
      try {
        var raw = localStorage.getItem({{ section.settings.wishlist_storage_key | json }});
        var parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed.length : 0;
      } catch (e) {
        return 0;
      }
    }

    function setWishlistCount(count) {
      count = Number(count) || 0;
      paint('[data-zh-wishlist]', '[data-zh-wishlist-count]', count);
      var dot = root.querySelector('[data-zh-wishlist-dot]');
      if (dot) dot.hidden = count === 0;
    }

    function syncWishlist() {
      setWishlistCount(readWishlist());
    }

    function onCartUpdated(event) {
      if (event.detail && typeof event.detail.count !== 'undefined') {
        setCartCount(event.detail.count);
      }
    }

    function onWishlistUpdated(event) {
      if (event.detail && typeof event.detail.count !== 'undefined') {
        setWishlistCount(event.detail.count);
      } else {
        syncWishlist();
      }
    }

    syncWishlist();
    document.addEventListener('zehn:cart:updated', onCartUpdated);
    document.addEventListener('zehn:wishlist:updated', onWishlistUpdated);
    window.addEventListener('storage', syncWishlist);

    window.ZehnHeader = {
      setCartCount: setCartCount,
      setWishlistCount: setWishlistCount,
      closeMenu: function () {
        setMenu(false);
        closeDropdown();
      },
    };

    /* ---------- teardown (theme editor reloads) ---------- */
    window.__zehnHeaders['{{ section.id }}'] = function () {
      cancelClose();
      document.removeEventListener('mousedown', onPointerDown);
      document.removeEventListener('touchstart', onPointerDown);
      document.removeEventListener('keydown', onKeyDown);
      document.removeEventListener('zehn:cart:updated', onCartUpdated);
      document.removeEventListener('zehn:wishlist:updated', onWishlistUpdated);
      window.removeEventListener('storage', syncWishlist);
    };
  })();
</script>

{% schema %}
{
  "name": "ZEHN header",
  "tag": "div",
  "class": "zehn-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Three levels: top links, dropdown accordions, links inside each accordion."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the shop name if empty."
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height (mobile)",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height_desktop",
      "label": "Logo height (desktop)",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "range",
      "id": "navbar_height",
      "label": "Navbar height",
      "min": 52,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "announcement_gap",
      "label": "Gap below announcement bar",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "card_opacity",
      "label": "Card background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "blur",
      "label": "Backdrop blur",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "enable_entrance",
      "label": "Fade and scale in on page load",
      "default": true
    },
    {
      "type": "number",
      "id": "z_index",
      "label": "Stacking order (z-index)",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0F1426"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FF5F1F"
    },
    {
      "type": "color",
      "id": "accent_foreground",
      "label": "Badge text",
      "default": "#F4F4F5"
    },
    {
      "type": "header",
      "content": "Dropdown"
    },
    {
      "type": "range",
      "id": "close_delay",
      "label": "Close delay after mouse leaves",
      "min": 0,
      "max": 600,
      "step": 50,
      "unit": "ms",
      "default": 150
    },
    {
      "type": "text",
      "id": "all_prefix",
      "label": "\"All\" link prefix",
      "default": "Alle",
      "info": "Renders as \"Alle Oberteile\" above each accordion's links."
    },
    {
      "type": "header",
      "content": "Wishlist"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist page",
      "info": "Leave empty to hide the wishlist icon and menu link."
    },
    {
      "type": "text",
      "id": "wishlist_label",
      "label": "Wishlist label",
      "default": "Wunschliste"
    },
    {
      "type": "text",
      "id": "wishlist_storage_key",
      "label": "Wishlist storage key",
      "default": "zehn-wishlist",
      "info": "localStorage key the count is read from. Must match the wishlist app."
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Navigation aria-label",
      "default": "Hauptnavigation"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart label",
      "default": "Warenkorb"
    }
  ],
  "presets": [
    {
      "name": "ZEHN header"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
