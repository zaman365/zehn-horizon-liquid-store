{%- comment -%}
  ============================================================================
  ZEHN hero — Liquid port of components/zehn/Hero.tsx + homepage-hero.css

  Install: sections/zehn-hero.liquid
  Add it as the FIRST section on the homepage template.

  Rolls the Hero component and its stylesheet into one section:
    - the fold wrapper that reserves space behind the floating navbar
    - crossfading slides (opacity + 1.025 scale, 1800ms)
    - art-directed mobile/desktop images per slide
    - the edge fade that blends the image into the fold background
    - the bottom-anchored heading and button

  The fold no longer hard-codes 102px/106px. It reads --zehn-header-stack from
  the header section, so changing the navbar height moves this too.

  One thing to do in layout/theme.liquid — a fixed header takes up no space in
  flow, so every page needs the stack reserved at the top:

    main { padding-top: var(--zehn-header-stack, 104px); }

  This section then cancels that padding for itself so the image runs up
  behind the navbar. Leave "Extend behind header" on for that.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign fade = section.settings.transition_ms
  assign bg = section.settings.fold_background
  assign slides = section.blocks
-%}

{%- style -%}
  #ZehnHero-{{ section.id }} {
    --zh-fold-bg: {{ bg }};
    --zh-fade: {{ fade }}ms;
    --zh-fade-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --zh-edge: {{ section.settings.edge_fade }}px;
    --zh-img-offset: {{ section.settings.image_offset_desktop }}px;
    --zh-img-offset-mobile: {{ section.settings.image_offset_mobile }}px;
    --zh-stack: var(--zehn-header-stack, 104px);

    position: relative;
    width: 100%;
    height: calc(
      100vw * {{ section.settings.mobile_height_pct }} / 100 + var(--zh-stack) -
        var(--zh-img-offset-mobile)
    );
    max-height: {{ section.settings.max_height_mobile }}dvh;
    overflow: hidden;
    background-color: var(--zh-fold-bg);
  }

  {%- if section.settings.extend_behind_header -%}
    #ZehnHero-{{ section.id }} { margin-top: calc(-1 * var(--zh-stack)); }
  {%- endif -%}

  #ZehnHero-{{ section.id }} .hero-viewport {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Blends the image edges into the flat fold colour. */
  #ZehnHero-{{ section.id }} .hero-viewport::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 8;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--zh-fold-bg) 0, transparent var(--zh-edge)),
      linear-gradient(270deg, var(--zh-fold-bg) 0, transparent var(--zh-edge));
  }

  #ZehnHero-{{ section.id }} .hero-stage {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  #ZehnHero-{{ section.id }} [data-hero-slide] {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.025);
    will-change: transform;
    transition:
      opacity var(--zh-fade) var(--zh-fade-ease),
      transform var(--zh-fade) var(--zh-fade-ease);
  }

  #ZehnHero-{{ section.id }} [data-hero-slide].is-active {
    opacity: 1;
    transform: scale(1);
  }

  #ZehnHero-{{ section.id }} .hero-slide-img {
    position: absolute;
    inset: 0;
    top: calc(var(--zh-stack) - var(--zh-img-offset-mobile));
    bottom: auto;
    display: block;
    width: 100%;
    height: calc(100% - var(--zh-stack) + var(--zh-img-offset-mobile));
    max-width: none;
    max-height: none;
    aspect-ratio: unset;
  }

  #ZehnHero-{{ section.id }} .hero-slide-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center {{ section.settings.focal_mobile }}%;
    border-radius: 0;
  }

  /* ---------- overlay ---------- */
  #ZehnHero-{{ section.id }} .hero-link {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: block;
    cursor: pointer;
  }

  #ZehnHero-{{ section.id }} .hero-content {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 80px;
    pointer-events: none;
  }

  #ZehnHero-{{ section.id }} .hero-content__inner {
    text-align: center;
    pointer-events: auto;
  }

  #ZehnHero-{{ section.id }} .hero-heading {
    margin: 0 0 12px;
    font-family: var(--font-display, 'Archivo', system-ui, sans-serif);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.45));
  }

  #ZehnHero-{{ section.id }} .hero-cta {
    display: inline-block;
    padding: 6px 20px;
    border-radius: 0;
    background: rgba(255, 255, 255, 0.9);
    font-family: var(--font-display, 'Archivo', system-ui, sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    color: {{ section.settings.cta_text_color }};
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    transition: transform 300ms ease, background-color 300ms ease;
  }

  #ZehnHero-{{ section.id }} .hero-cta:hover {
    transform: scale(1.05);
    background: #fff;
    text-decoration: none;
  }

  #ZehnHero-{{ section.id }} .hero-link:focus-visible,
  #ZehnHero-{{ section.id }} .hero-cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* ---------- breakpoints ---------- */
  @media (min-width: 640px) {
    #ZehnHero-{{ section.id }} .hero-content { padding-bottom: 96px; }
  }

  @media (min-width: 1024px) {
    #ZehnHero-{{ section.id }} {
      height: calc(
        100vw / {{ section.settings.desktop_ratio }} + var(--zh-stack) -
          var(--zh-img-offset)
      );
      min-height: {{ section.settings.min_height_desktop }}px;
      max-height: min({{ section.settings.max_height_desktop }}dvh, calc(100dvh - 100px));
    }

    #ZehnHero-{{ section.id }} .hero-slide-img {
      top: calc(var(--zh-stack) - var(--zh-img-offset));
      height: calc(100% - var(--zh-stack) + var(--zh-img-offset));
    }

    #ZehnHero-{{ section.id }} .hero-slide-img img {
      object-position: center {{ section.settings.focal_desktop }}%;
    }

    #ZehnHero-{{ section.id }} .hero-content { padding-bottom: 112px; }

    #ZehnHero-{{ section.id }} .hero-heading {
      margin-bottom: 20px;
      font-size: 39px;
      letter-spacing: 0.18em;
      filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.45));
    }

    #ZehnHero-{{ section.id }} .hero-cta {
      padding: 12px 40px;
      font-size: 14px;
      letter-spacing: 0.25em;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
    }
  }

  @media (min-width: 1280px) {
    #ZehnHero-{{ section.id }} .hero-content { padding-bottom: 128px; }
    #ZehnHero-{{ section.id }} .hero-heading { font-size: 47px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZehnHero-{{ section.id }} [data-hero-slide] {
      transform: none;
      transition-duration: 200ms;
    }
    #ZehnHero-{{ section.id }} [data-hero-slide].is-active { transform: none; }
    #ZehnHero-{{ section.id }} .hero-cta { transition: none; }
    #ZehnHero-{{ section.id }} .hero-cta:hover { transform: none; }
  }
{%- endstyle -%}

<div
  id="ZehnHero-{{ section.id }}"
  class="zehn-hero"
  data-homepage-hero-fold
  data-zehn-hero
  data-interval="{{ section.settings.slide_seconds | times: 1000 }}"
  data-autoplay="{{ section.settings.autoplay }}"
>
  <div class="hero-viewport" data-homepage-hero>
    <div class="hero-stage">
      {%- for block in slides -%}
        {%- liquid
          assign desktop = block.settings.desktop_image
          assign mobile = block.settings.mobile_image | default: desktop
          assign alt = desktop.alt | default: section.settings.heading | default: shop.name
          assign is_first = false
          if forloop.first
            assign is_first = true
          endif
        -%}

        <div
          data-hero-slide="{{ block.id }}"
          class="{% if is_first %}is-active{% endif %}"
          {{ block.shopify_attributes }}
        >
          <picture class="hero-slide-img">
            {%- if mobile != blank -%}
              <source
                media="(max-width: 1023px)"
                srcset="
                  {{ mobile | image_url: width: 600 }} 600w,
                  {{ mobile | image_url: width: 900 }} 900w,
                  {{ mobile | image_url: width: 1200 }} 1200w,
                  {{ mobile | image_url: width: 1600 }} 1600w
                "
                sizes="100vw"
              >
            {%- endif -%}
            {%- if desktop != blank -%}
              <source
                media="(min-width: 1024px)"
                srcset="
                  {{ desktop | image_url: width: 1200 }} 1200w,
                  {{ desktop | image_url: width: 1600 }} 1600w,
                  {{ desktop | image_url: width: 2200 }} 2200w,
                  {{ desktop | image_url: width: 2800 }} 2800w
                "
                sizes="100vw"
              >
              <img
                src="{{ desktop | image_url: width: 2200 }}"
                alt="{{ alt | escape }}"
                width="{{ desktop.width }}"
                height="{{ desktop.height }}"
                decoding="async"
                loading="{% if is_first %}eager{% else %}lazy{% endif %}"
                fetchpriority="{% if is_first %}high{% else %}auto{% endif %}"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-placeholder' }}
            {%- endif -%}
          </picture>
        </div>
      {%- endfor -%}

      {%- if section.settings.link != blank -%}
        <a
          class="hero-link"
          href="{{ section.settings.link }}"
          aria-label="{{ section.settings.link_label | escape }}"
        ></a>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.cta_label != blank -%}
        <div class="hero-content">
          <div class="hero-content__inner">
            {%- if section.settings.heading != blank -%}
              <h1 class="hero-heading">{{ section.settings.heading }}</h1>
            {%- endif -%}
            {%- if section.settings.cta_label != blank -%}
              <a class="hero-cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
                {{ section.settings.cta_label }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if slides.size > 1 -%}
  <script>
    (function () {
      var root = document.getElementById('ZehnHero-{{ section.id }}');
      if (!root) return;

      window.__zehnHeroes = window.__zehnHeroes || {};
      if (window.__zehnHeroes['{{ section.id }}']) {
        window.__zehnHeroes['{{ section.id }}']();
      }

      var slides = root.querySelectorAll('[data-hero-slide]');
      if (slides.length < 2) return;

      var interval = parseInt(root.dataset.interval, 10) || 10000;
      var autoplay = root.dataset.autoplay === 'true';
      var index = 0;
      var timer = null;

      function show(next) {
        slides[index].classList.remove('is-active');
        index = (next + slides.length) % slides.length;
        slides[index].classList.add('is-active');
      }

      function start() {
        stop();
        if (!autoplay) return;
        timer = setInterval(function () {
          show(index + 1);
        }, interval);
      }

      function stop() {
        if (timer) clearInterval(timer);
        timer = null;
      }

      function onVisibility() {
        if (document.hidden) {
          stop();
        } else {
          start();
        }
      }

      document.addEventListener('visibilitychange', onVisibility);
      start();

      window.__zehnHeroes['{{ section.id }}'] = function () {
        stop();
        document.removeEventListener('visibilitychange', onVisibility);
      };
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "ZEHN hero",
  "tag": "div",
  "class": "zehn-hero-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SOMMERKOLLEKTION"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "ENTDECKEN"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "The whole banner is clickable, not just the button."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Banner link aria-label",
      "default": "Zur Kollektion"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#0F1426"
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "slide_seconds",
      "label": "Seconds per slide",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 10
    },
    {
      "type": "range",
      "id": "transition_ms",
      "label": "Crossfade duration",
      "min": 400,
      "max": 3000,
      "step": 100,
      "unit": "ms",
      "default": 1800
    },
    {
      "type": "header",
      "content": "Fold sizing"
    },
    {
      "type": "checkbox",
      "id": "extend_behind_header",
      "label": "Extend behind header",
      "default": true,
      "info": "Cancels the top padding on main so the banner runs up behind the navbar. Only for the first section on a page."
    },
    {
      "type": "color",
      "id": "fold_background",
      "label": "Background behind navbar",
      "default": "#E1E2E6"
    },
    {
      "type": "range",
      "id": "mobile_height_pct",
      "label": "Mobile height",
      "min": 90,
      "max": 130,
      "step": 0.5,
      "unit": "%",
      "default": 102.5,
      "info": "Percentage of the viewport width."
    },
    {
      "type": "range",
      "id": "max_height_mobile",
      "label": "Mobile max height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "desktop_ratio",
      "label": "Desktop width-to-height ratio",
      "min": 2,
      "max": 3.5,
      "step": 0.1,
      "default": 2.5
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Desktop min height",
      "min": 320,
      "max": 720,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "max_height_desktop",
      "label": "Desktop max height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 95
    },
    {
      "type": "header",
      "content": "Image framing"
    },
    {
      "type": "range",
      "id": "focal_mobile",
      "label": "Focal point (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 42
    },
    {
      "type": "range",
      "id": "focal_desktop",
      "label": "Focal point (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_offset_mobile",
      "label": "Image overlap into navbar (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 39
    },
    {
      "type": "range",
      "id": "image_offset_desktop",
      "label": "Image overlap into navbar (desktop)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "edge_fade",
      "label": "Edge fade width",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image",
          "info": "Wide crop, around 2200 × 800."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Taller crop, around 1200 × 1000. Falls back to the desktop image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZEHN hero",
      "blocks": [
        {"type": "slide"},
        {"type": "slide"},
        {"type": "slide"}
      ]
    }
  ]
}
{% endschema %}
