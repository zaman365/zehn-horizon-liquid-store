{%- comment -%}
  ============================================================
  homepage-product-sliders.liquid
  Liquid port of app/components/HomepageProductSliders.tsx

  One block = one slider (was one item in the `sections` prop).
  Design values are taken from the Tailwind classes in the TSX and
  from the ZEHN tokens + .homepage-product-card overrides in app.css.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign has_output = false
-%}

<div class="hps-root" data-hps-root>
  <div class="hps-sliders">
    {%- for block in section.blocks -%}
      {%- liquid
        assign coll = block.settings.collection
        assign limit = block.settings.products_to_show
        assign dedupe = block.settings.dedupe_by_title
        assign heading = block.settings.heading
      -%}

      {%- comment -%} Pass 1: build the cards so an empty slider can be dropped entirely (React returned null). {%- endcomment -%}
      {%- capture cards -%}
        {%- assign seen_keys = '|' -%}
        {%- for product in coll.products limit: limit -%}

          {%- comment -%} getDisplayHomepageSliderProducts: keep only priced products {%- endcomment -%}
          {%- if product.price == blank -%}{%- continue -%}{%- endif -%}

          {%- comment -%} getProductUniquenessKey: title.trim().toLowerCase().replace(/\s+/g,' ') {%- endcomment -%}
          {%- assign norm_title = product.title | downcase | split: ' ' | join: ' ' -%}
          {%- if norm_title != blank -%}
            {%- assign uniq_key = 'title:' | append: norm_title -%}
          {%- else -%}
            {%- assign uniq_key = 'product:' | append: product.handle -%}
          {%- endif -%}

          {%- if dedupe -%}
            {%- assign needle = '|' | append: uniq_key | append: '|' -%}
            {%- if seen_keys contains needle -%}{%- continue -%}{%- endif -%}
            {%- assign seen_keys = seen_keys | append: uniq_key | append: '|' -%}
          {%- endif -%}

          {%- liquid
            assign card_image = product.featured_media.preview_image
            assign card_alt = product.featured_media.alt | default: product.title | escape
          -%}

          <div class="hps-item">
            <div class="hps-card-shell" data-hps-card>
              <div class="hps-card-skeleton" data-hps-card-skeleton aria-hidden="true"></div>

              <a
                class="hps-card homepage-product-card"
                href="{{ product.url }}"
                aria-label="{{ product.title | escape }}"
              >
                <div class="hps-media">
                  {%- if card_image -%}
                    {{
                      card_image
                      | image_url: width: 560
                      | image_tag:
                        loading: 'lazy',
                        class: 'hps-img',
                        alt: card_alt,
                        widths: '240,280,360,480,560',
                        sizes: '(min-width: 640px) 280px, 240px'
                    }}
                  {%- else -%}
                    <div class="hps-img hps-img--empty" aria-hidden="true"></div>
                  {%- endif -%}
                </div>

                <div class="hps-body">
                  <h3 class="hps-name">{{ product.title }}</h3>
                  <p class="hps-price">
                    {%- if product.price_varies -%}
                      ab {{ product.price_min | money }}
                    {%- else -%}
                      {{ product.price | money }}
                    {%- endif -%}
                  </p>
                </div>
              </a>
            </div>
          </div>
        {%- endfor -%}
      {%- endcapture -%}

      {%- if cards != blank -%}
        {%- assign has_output = true -%}
        <section
          class="hps-slider"
          data-hps-slider
          {% if forloop.first %}data-hps-ready="true"{% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="hps-head">
            <h2 class="hps-title">{{ heading }}</h2>

            <div class="hps-nav">
              <button
                type="button"
                class="hps-arrow"
                data-hps-scroll="left"
                aria-label="{{ heading | escape }} vorherige Produkte"
              >
                <svg class="hps-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="m15 18-6-6 6-6" />
                </svg>
              </button>
              <button
                type="button"
                class="hps-arrow"
                data-hps-scroll="right"
                aria-label="{{ heading | escape }} nächste Produkte"
              >
                <svg class="hps-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </button>
            </div>
          </div>

          <div class="hps-rail intentional-horizontal-scroll scrollbar-hide" data-hps-rail>
            <div class="hps-rail-skeleton" data-hps-rail-skeleton aria-hidden="true"></div>
            {{ cards }}
          </div>
        </section>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{%- unless has_output -%}
  {%- comment -%} visibleSections.length === 0 -> render nothing {%- endcomment -%}
  <style>#shopify-section-{{ section.id }} .hps-root { display: none; }</style>
{%- endunless -%}

{% stylesheet %}
/* ---------- tokens -------------------------------------------------- */
.hps-root {
  --hps-card: #ffffff;                     /* Tailwind bg-card */
  --hps-card-30: rgba(255, 255, 255, 0.3); /* bg-card/30 */
  --hps-border-20: rgba(142, 151, 164, 0.2); /* border-border/20 (#8E97A4) */
  --hps-shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);

  margin-bottom: 1.25rem; /* mb-5 */
}

@supports (background: color-mix(in srgb, red 30%, transparent)) {
  .hps-root {
    --hps-card-30: color-mix(in srgb, var(--hps-card) 30%, transparent);
  }
}

.hps-sliders {
  display: flex;
  flex-direction: column;
  gap: 2rem; /* space-y-8 */
}

/* ---------- slider shell ------------------------------------------- */
.hps-slider {
  border-top: 1px solid var(--hps-border-20);
  padding: 0.75rem 0 0; /* pt-3, overrides the global `section { padding: 1rem 0 }` reset */
}

.hps-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem; /* mb-4 */
}

.hps-title {
  /* font-sans in the TSX beats the global `h1..h6 { font-family: var(--font-display) }` */
  font-family: var(--font-body, 'Inter', system-ui, sans-serif);
  font-size: 1.25rem; /* text-xl */
  line-height: 1.75rem;
  font-weight: 700;
  color: var(--color-foreground);
  margin: 0;
}

.hps-nav {
  display: flex;
  align-items: center;
  gap: 0.5rem; /* gap-2 */
  flex-shrink: 0;
}

.hps-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;  /* h-10 w-10 */
  height: 2.5rem;
  padding: 0;
  border: 0;
  border-radius: 9999px;
  background-color: var(--hps-card);
  color: var(--color-foreground);
  box-shadow: var(--hps-shadow-md);
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease;
}

.hps-arrow:hover {
  background-color: var(--color-foreground);
  color: var(--color-background);
}

.hps-arrow:focus-visible {
  outline: 2px solid var(--color-foreground);
  outline-offset: 2px;
}

.hps-icon {
  width: 1.25rem; /* h-5 w-5 */
  height: 1.25rem;
}

/* ---------- rail ---------------------------------------------------- */
.hps-rail {
  display: flex;
  gap: 0.75rem; /* gap-3 */
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  padding-bottom: 0.75rem; /* pb-3 */

  /* .intentional-horizontal-scroll + .scrollbar-hide, inlined so the
     section also works if those globals are not in the theme */
  overscroll-behavior-inline: contain;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-x pan-y pinch-zoom;
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.hps-rail::-webkit-scrollbar { display: none; }

.hps-item {
  width: 240px; /* w-[240px] */
  flex-shrink: 0;
  scroll-snap-align: start;
}

/* ---------- card ---------------------------------------------------- */
.hps-card-shell {
  position: relative;
  min-height: 390px; /* min-h-[390px] */
}

.hps-card {
  display: block;
  overflow: hidden;
  border-radius: 1rem; /* .homepage-product-card .bg-card */
  background-color: var(--hps-card);
  color: var(--color-foreground);
  text-decoration: none;
}

.hps-card:hover { text-decoration: none; }

.hps-media {
  position: relative;
  aspect-ratio: 7 / 10;
  overflow: hidden;
}

.hps-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 0; /* beats the global `img { border-radius: 4px }` */
}

.hps-img--empty { background-color: var(--hps-card-30); }

.hps-body {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  height: 85px; /* .homepage-product-card .h-[100px] */
  padding: 0.625rem; /* px-3 / pt-3 / pb-3 scaled */
}

.hps-name {
  font-family: var(--font-body, 'Inter', system-ui, sans-serif);
  font-size: 0.95rem;
  line-height: 1.3;
  font-weight: 600;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hps-price {
  font-size: 0.8125rem;
  line-height: 1.3;
  margin: 0;
  margin-top: auto;
}

/* ---------- deferred render (IntersectionObserver parity) ----------- */
.hps-rail-skeleton,
.hps-card-skeleton {
  display: none;
  background-color: var(--hps-card-30);
}

[data-hps-root][data-hps-js='true'] [data-hps-slider]:not([data-hps-ready='true']) .hps-item {
  display: none;
}

[data-hps-root][data-hps-js='true'] [data-hps-slider]:not([data-hps-ready='true']) .hps-rail-skeleton {
  display: block;
  width: 100%;
  height: 390px; /* h-[390px] */
  border-radius: 1.5rem; /* rounded-3xl */
}

[data-hps-root][data-hps-js='true'] [data-hps-card]:not([data-hps-card-ready='true']) .hps-card {
  visibility: hidden;
}

[data-hps-root][data-hps-js='true'] [data-hps-card]:not([data-hps-card-ready='true']) .hps-card-skeleton {
  display: block;
  position: absolute;
  inset: 0 0 auto;
  aspect-ratio: 7 / 10;
  border-radius: 1.5rem;
}

/* ---------- sm: breakpoint (640px) --------------------------------- */
@media (min-width: 640px) {
  .hps-root { margin-bottom: 1.75rem; }        /* sm:mb-7 */
  .hps-sliders { gap: 2.5rem; }                /* sm:space-y-10 */
  .hps-slider { padding-top: 1rem; }           /* sm:pt-4 */
  .hps-title { font-size: 1.5rem; line-height: 2rem; } /* sm:text-2xl */
  .hps-item { width: 280px; }                  /* sm:w-[280px] */
  .hps-card-shell { min-height: 450px; }       /* sm:min-h-[450px] */

  [data-hps-root][data-hps-js='true'] [data-hps-slider]:not([data-hps-ready='true']) .hps-rail-skeleton {
    height: 450px; /* sm:h-[450px] */
  }
}

@media (prefers-reduced-motion: reduce) {
  .hps-rail { scroll-behavior: auto; }
  .hps-arrow { transition: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  var SCROLL_STEP = 340; // scrollBy left: ±340

  function initRoot(root) {
    if (!root || root.dataset.hpsInit === 'true') return;
    root.dataset.hpsInit = 'true';

    var supportsIO = typeof IntersectionObserver !== 'undefined';
    root.dataset.hpsJs = 'true';

    root.querySelectorAll('[data-hps-slider]').forEach(function (slider) {
      var rail = slider.querySelector('[data-hps-rail]');
      if (!rail) return;

      slider.querySelectorAll('[data-hps-scroll]').forEach(function (button) {
        button.addEventListener('click', function () {
          rail.scrollBy({
            left: button.dataset.hpsScroll === 'left' ? -SCROLL_STEP : SCROLL_STEP,
            behavior: 'smooth'
          });
        });
      });

      function revealCards() {
        var cards = rail.querySelectorAll('[data-hps-card]');

        if (!supportsIO) {
          cards.forEach(function (card) { card.dataset.hpsCardReady = 'true'; });
          return;
        }

        // { root: rail, rootMargin: '0px 160px' }
        var cardObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.dataset.hpsCardReady = 'true';
              cardObserver.unobserve(entry.target);
            });
          },
          { root: rail, rootMargin: '0px 160px' }
        );

        cards.forEach(function (card) { cardObserver.observe(card); });
      }

      if (slider.dataset.hpsReady === 'true' || !supportsIO) {
        slider.dataset.hpsReady = 'true';
        revealCards();
        return;
      }

      // { rootMargin: '200px 0px' }
      var sectionObserver = new IntersectionObserver(
        function (entries) {
          if (!entries[0] || !entries[0].isIntersecting) return;
          slider.dataset.hpsReady = 'true';
          sectionObserver.disconnect();
          revealCards();
        },
        { rootMargin: '200px 0px' }
      );
      sectionObserver.observe(slider);
    });
  }

  function initAll(scope) {
    (scope || document).querySelectorAll('[data-hps-root]').forEach(initRoot);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAll(); });
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', function (event) {
    initAll(event.target);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Product sliders",
  "tag": "div",
  "class": "homepage-product-sliders",
  "max_blocks": 12,
  "settings": [],
  "blocks": [
    {
      "type": "slider",
      "name": "Slider",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Neu eingetroffen"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "label": "Products to show",
          "min": 4,
          "max": 24,
          "step": 1,
          "default": 12
        },
        {
          "type": "checkbox",
          "id": "dedupe_by_title",
          "label": "Hide duplicate titles",
          "info": "Matches dedupeByTitle in the Hydrogen component.",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product sliders",
      "blocks": [{ "type": "slider" }, { "type": "slider" }]
    }
  ]
}
{% endschema %}
