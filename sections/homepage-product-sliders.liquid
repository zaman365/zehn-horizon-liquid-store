{%- comment -%}
  ============================================================
  sections/homepage-product-sliders.liquid
  Liquid port of app/components/zehn/HomepageProductSliders.tsx

  One block = one entry of the `sections` prop.
  Requires: snippets/product-card.liquid (markup + CSS + JS + quick-add sheet)
            templates/product.quick-add.liquid (quick-add options fragment)
  ============================================================
{%- endcomment -%}

{%- comment -%} Card CSS + JS + shared quick-add sheet. Prints no markup. {%- endcomment -%}
{%- render 'product-card', assets_only: true -%}

<div class="hps-root">
  <div class="hps-sliders">
    {%- for block in section.blocks -%}
      {%- liquid
        assign coll = block.settings.collection
        assign limit = block.settings.products_to_show
        assign dedupe = block.settings.dedupe_by_title
        assign heading = block.settings.heading
        assign eager_count = 0
        if forloop.first
          assign eager_count = block.settings.eager_images
        endif
      -%}

      {%- comment -%} Pass 1: build the cards so an empty slider can be dropped (React returned null). {%- endcomment -%}
      {%- capture cards -%}
        {%- assign seen_keys = '|' -%}
        {%- assign card_index = 0 -%}
        {%- for product in coll.products limit: limit -%}

          {%- comment -%} getDisplayHomepageSliderProducts: priced products only {%- endcomment -%}
          {%- if product.price == blank -%}{%- continue -%}{%- endif -%}

          {%- comment -%} getProductUniquenessKey: title.trim().toLowerCase().replace(/\s+/g,' ') {%- endcomment -%}
          {%- assign norm_title = product.title | downcase | split: ' ' | join: ' ' -%}
          {%- if norm_title != blank -%}
            {%- assign uniq_key = 'title:' | append: norm_title -%}
          {%- else -%}
            {%- assign uniq_key = 'product:' | append: product.handle -%}
          {%- endif -%}

          {%- if dedupe -%}
            {%- assign needle = '|' | append: uniq_key | append: '|' -%}
            {%- if seen_keys contains needle -%}{%- continue -%}{%- endif -%}
            {%- assign seen_keys = seen_keys | append: uniq_key | append: '|' -%}
          {%- endif -%}

          {%- liquid
            assign card_loading = 'lazy'
            if card_index < eager_count
              assign card_loading = 'eager'
            endif
          -%}

          <div class="hps-item">
            {%- render 'product-card',
              product: product,
              index: card_index,
              loading: card_loading,
              image_sizes: '(min-width: 640px) 280px, 240px'
            -%}
          </div>

          {%- assign card_index = card_index | plus: 1 -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if cards != blank -%}
        <section class="hps-slider" data-hps-slider {{ block.shopify_attributes }}>
          <div class="hps-head">
            <h2 class="hps-title">{{ heading }}</h2>

            <div class="hps-nav">
              <button
                type="button"
                class="hps-arrow"
                data-hps-scroll="left"
                aria-label="{{ heading | escape }} vorherige Produkte"
              >
                <svg class="hps-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <button
                type="button"
                class="hps-arrow"
                data-hps-scroll="right"
                aria-label="{{ heading | escape }} nächste Produkte"
              >
                <svg class="hps-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
          </div>

          <div class="hps-rail intentional-horizontal-scroll scrollbar-hide" data-hps-rail>
            {{ cards }}
          </div>
        </section>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
.hps-root {
  --hps-card: #ffffff;                       /* bg-card */
  --hps-border-20: rgba(142, 151, 164, 0.2); /* border-border/20 */
  --hps-shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  margin-bottom: 1.25rem; /* mb-5 */
  max-width: 1400px;
  margin: 0px auto;
}

.hps-sliders {
  display: flex;
  flex-direction: column;
  gap: 2rem; /* space-y-8 */
}

/* Offscreen sliders and cards skip layout/paint entirely — this is what the
   two IntersectionObservers in the React version were emulating. */
.hps-slider {
  border-top: 1px solid var(--hps-border-20);
  padding: 0.75rem 0 0; /* pt-3; also neutralises the global `section { padding: 1rem 0 }` */
  content-visibility: auto;
  contain-intrinsic-size: auto 480px;
}

.hps-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem; /* mb-4 */
}

.hps-title {
  /* font-sans beats the global `h1..h6 { font-family: var(--font-display) }` */
  font-family: var(--font-body, 'Inter', system-ui, sans-serif);
  font-size: 1.25rem; /* text-xl */
  line-height: 1.75rem;
  font-weight: 700;
  color: var(--color-foreground, #0f1426);
  margin: 0;
}

.hps-nav { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }

.hps-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;  /* h-10 w-10 */
  height: 2.5rem;
  padding: 0;
  border: 0;
  border-radius: 9999px;
  background-color: var(--hps-card);
  color: var(--color-foreground, #0f1426);
  box-shadow: var(--hps-shadow-md);
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease;
}

.hps-arrow:hover {
  background-color: var(--color-foreground, #0f1426);
  color: var(--color-background, #f4f4f5);
}

.hps-arrow:focus-visible {
  outline: 2px solid var(--color-foreground, #0f1426);
  outline-offset: 2px;
}

.hps-icon { width: 1.25rem; height: 1.25rem; }

.hps-rail {
  display: flex;
  gap: 0.75rem; /* gap-3 */
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  padding-bottom: 0.75rem; /* pb-3 */

  /* .intentional-horizontal-scroll + .scrollbar-hide, inlined */
  overscroll-behavior-inline: contain;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-x pan-y pinch-zoom;
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.hps-rail::-webkit-scrollbar { display: none; }

.hps-item {
  width: 240px; /* w-[240px] */
  flex-shrink: 0;
  scroll-snap-align: start;
  min-height: 390px; /* min-h-[390px] */
  content-visibility: auto;
  contain-intrinsic-size: 240px 390px;
}

@media (min-width: 640px) {
  .hps-root { margin-bottom: 1.75rem; }                /* sm:mb-7 */
  .hps-sliders { gap: 2.5rem; }                        /* sm:space-y-10 */
  .hps-slider { padding-top: 1rem; }                   /* sm:pt-4 */
  .hps-title { font-size: 1.5rem; line-height: 2rem; } /* sm:text-2xl */
  .hps-item {
    width: 280px;                                      /* sm:w-[280px] */
    min-height: 450px;                                 /* sm:min-h-[450px] */
    contain-intrinsic-size: 280px 450px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hps-rail { scroll-behavior: auto; }
  .hps-arrow { transition: none; }
}
{% endstylesheet %}

{% javascript %}
/* One delegated listener for every slider on the page. */
document.addEventListener('click', function (event) {
  var button = event.target.closest && event.target.closest('[data-hps-scroll]');
  if (!button) return;

  var slider = button.closest('[data-hps-slider]');
  var rail = slider && slider.querySelector('[data-hps-rail]');
  if (!rail) return;

  rail.scrollBy({
    left: button.dataset.hpsScroll === 'left' ? -340 : 340, // scrollBy({left: ±340})
    behavior: 'smooth'
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Product sliders",
  "tag": "div",
  "class": "homepage-product-sliders",
  "max_blocks": 12,
  "settings": [],
  "blocks": [
    {
      "type": "slider",
      "name": "Slider",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Neu eingetroffen"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "label": "Products to show",
          "min": 4,
          "max": 24,
          "step": 1,
          "default": 12
        },
        {
          "type": "checkbox",
          "id": "dedupe_by_title",
          "label": "Hide duplicate titles",
          "info": "Matches dedupeByTitle in the Hydrogen component.",
          "default": true
        },
        {
          "type": "range",
          "id": "eager_images",
          "label": "Images loaded immediately",
          "info": "Only applies to the first slider. Use 2 if it sits near the top of the page, 0 if it is below the fold.",
          "min": 0,
          "max": 4,
          "step": 1,
          "default": 2
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product sliders",
      "blocks": [{ "type": "slider" }, { "type": "slider" }]
    }
  ]
}
{% endschema %}
