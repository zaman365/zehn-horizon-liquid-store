{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{%- liquid
  assign slide_indices = '1,2,3,4,5' | split: ','
  assign initial_background = section.settings.slide_1_background_color
  assign initial_text = section.settings.slide_1_text_color
-%}

{%- capture slide_colors -%}
  {%- for i in slide_indices -%}
    {%- assign bg_key = 'slide_' | append: i | append: '_background_color' -%}
    {%- assign text_key = 'slide_' | append: i | append: '_text_color' -%}
    {%- assign slide_bg = section.settings[bg_key] -%}
    {%- assign slide_text = section.settings[text_key] -%}
    {%- if slide_bg != blank or slide_text != blank -%}
      #announcement-bar-{{ section.id }} .announcement-bar__slides > *:nth-child({{ i }}) {
        {% if slide_bg != blank %}--slide-background-color: {{ slide_bg }};{% endif %}
        {% if slide_text != blank %}--slide-text-color: {{ slide_text }};{% endif %}
      }
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if slide_colors != blank -%}
  <style>{{ slide_colors }}</style>
{%- endif -%}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  id="announcement-bar-{{ section.id }}"
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}{% if initial_background != blank %} --announcement-active-background: {{ initial_background }};{% endif %}{% if initial_text != blank %} --announcement-active-text: {{ initial_text }}; --color-foreground: {{ initial_text }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>
</aside>

{%- if section.blocks.size > 1 -%}
  <script>
    (() => {
      const init = () => {
        const root = document.getElementById('announcement-bar-{{ section.id }}');
        if (!root || root.dataset.slideColorsInit === 'true') return;

        let slides = root.querySelectorAll('.announcement-bar__slide');
        if (!slides.length) slides = root.querySelectorAll('.announcement-bar__slides > *');
        if (slides.length < 2) return;

        root.dataset.slideColorsInit = 'true';

        const sync = () => {
          const active =
            Array.from(slides).find((slide) => slide.getAttribute('aria-hidden') !== 'true') || slides[0];
          const styles = getComputedStyle(active);
          const background = styles.getPropertyValue('--slide-background-color').trim();
          const text = styles.getPropertyValue('--slide-text-color').trim();

          if (background) {
            root.style.setProperty('--announcement-active-background', background);
          } else {
            root.style.removeProperty('--announcement-active-background');
          }

          if (text) {
            root.style.setProperty('--announcement-active-text', text);
            root.style.setProperty('--color-foreground', text);
          } else {
            root.style.removeProperty('--announcement-active-text');
            root.style.removeProperty('--color-foreground');
          }
        };

        sync();

        const observer = new MutationObserver(sync);
        slides.forEach((slide) =>
          observer.observe(slide, { attributes: true, attributeFilter: ['aria-hidden'] })
        );
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
      } else {
        init();
      }
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    position: relative;
    z-index: 1;
    background-color: var(--announcement-active-background, transparent);
    color: var(--announcement-active-text, inherit);
    transition: background-color 0.5s ease-in-out, color 0.5s ease-in-out;
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--announcement-active-text, var(--color-foreground));
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "Per-slide colours"
    },
    {
      "type": "paragraph",
      "content": "Set a background and text colour for each announcement, in the order the announcements appear above. Leave blank to use the section colours."
    },
    {
      "type": "color",
      "id": "slide_1_background_color",
      "label": "Slide 1 background",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "slide_1_text_color",
      "label": "Slide 1 text",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "slide_2_background_color",
      "label": "Slide 2 background",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "slide_2_text_color",
      "label": "Slide 2 text",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "slide_3_background_color",
      "label": "Slide 3 background",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "slide_3_text_color",
      "label": "Slide 3 text",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "slide_4_background_color",
      "label": "Slide 4 background",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "slide_4_text_color",
      "label": "Slide 4 text",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "slide_5_background_color",
      "label": "Slide 5 background",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "slide_5_text_color",
      "label": "Slide 5 text",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}