{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{%- liquid
  assign first_block = section.blocks.first
  assign initial_background = first_block.settings.slide_background_color
  assign initial_text = first_block.settings.slide_text_color
-%}

{%- capture slide_colors -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.slide_background_color != blank or block.settings.slide_text_color != blank -%}
      #announcement-bar-{{ section.id }} .announcement-bar__slides > *:nth-child({{ forloop.index }}) {
        {% if block.settings.slide_background_color != blank %}--slide-background-color: {{ block.settings.slide_background_color }};{% endif %}
        {% if block.settings.slide_text_color != blank %}--slide-text-color: {{ block.settings.slide_text_color }};{% endif %}
      }
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if slide_colors != blank -%}
  <style>{{ slide_colors }}</style>
{%- endif -%}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  id="announcement-bar-{{ section.id }}"
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}{% if initial_background != blank %} --announcement-active-background: {{ initial_background }};{% endif %}{% if initial_text != blank %} --announcement-active-text: {{ initial_text }}; --color-foreground: {{ initial_text }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>
</aside>

{%- if section.blocks.size > 1 -%}
  <script>
    (() => {
      const root = document.getElementById('announcement-bar-{{ section.id }}');
      if (!root || root.dataset.slideColorsInit === 'true') return;
      root.dataset.slideColorsInit = 'true';

      let slides = root.querySelectorAll('.announcement-bar__slide');
      if (!slides.length) slides = root.querySelectorAll('.announcement-bar__slides > *');
      if (slides.length < 2) return;

      const sync = () => {
        const active =
          Array.from(slides).find((slide) => slide.getAttribute('aria-hidden') !== 'true') || slides[0];
        const styles = getComputedStyle(active);
        const background = styles.getPropertyValue('--slide-background-color').trim();
        const text = styles.getPropertyValue('--slide-text-color').trim();

        if (background) {
          root.style.setProperty('--announcement-active-background', background);
        } else {
          root.style.removeProperty('--announcement-active-background');
        }

        if (text) {
          root.style.setProperty('--announcement-active-text', text);
          root.style.setProperty('--color-foreground', text);
        } else {
          root.style.removeProperty('--announcement-active-text');
          root.style.removeProperty('--color-foreground');
        }
      };

      sync();
      const observer = new MutationObserver(sync);
      slides.forEach((slide) =>
        observer.observe(slide, { attributes: true, attributeFilter: ['aria-hidden'] })
      );
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    position: relative;
    z-index: 1;
    background-color: var(--announcement-active-background, transparent);
    color: var(--announcement-active-text, inherit);
    transition: background-color 0.5s ease-in-out, color 0.5s ease-in-out;
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--announcement-active-text, var(--color-foreground));
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}