{%- comment -%}
  ZEHN — Footer  (Hydrogen `Footer.tsx` → Shopify Liquid, 1:1 conversion)
  Place in: sections/zehn-footer.liquid

  Self-contained: no Tailwind / theme utility classes required.
  Newsletter uses Shopify's native {% form 'customer' %} (from the previous Liquid version).

  Token mapping taken from app.css:
    bg-foreground            → #0F1426  (--color-zehn-indigo)
    text-primary-foreground  → #F4F4F5  (--color-zehn-platinum)
    text-accent              → #FF5F1F  (--color-zehn-signal)
    border-border            → #8E97A4  (--color-zehn-slate)
    bg-card                  → #FFFFFF
    text-red-400             → #F87171
  Breakpoints match Tailwind: sm 640 / md 768 / lg 1024.

  Assets to upload to /assets:
    ZEHN_Wordmark_with_logo.webp
    ZEHN_Platinum.svg
    visa.svg  mastercard.svg  paypal.svg  klarna.svg
{%- endcomment -%}

{%- liquid
  assign cols = section.blocks.size | plus: 1 | at_most: 4
  assign year = 'now' | date: '%Y'
  assign bp = section.settings.grid_breakpoint

  assign logo_src = ''
  if section.settings.logo != blank
    assign logo_src = section.settings.logo | image_url: width: 600
  elsif section.settings.logo_asset != blank
    assign logo_src = section.settings.logo_asset | asset_url
  endif

    assign watermark_src = section.settings.watermark_image | image_url: width: 1400

  assign c_text = section.settings.color_text
  assign c_border = section.settings.color_border

  assign pt_base = section.settings.padding_top | times: 0.667 | round
  assign pt_sm = section.settings.padding_top | times: 0.833 | round
  assign pb_base = section.settings.padding_bottom | times: 0.75 | round
  assign gap_sm = section.settings.column_gap | times: 0.6 | round
-%}

<style>
  #shopify-section-{{ section.id }} .zf {
    --zf-bg: {{ section.settings.color_bg }};
    --zf-text: {{ c_text }};
    --zf-accent: {{ section.settings.color_accent }};
    --zf-link: {{ c_text | color_modify: 'alpha', 0.7 }};
    --zf-chevron: {{ c_text | color_modify: 'alpha', 0.6 }};
    --zf-rule: {{ c_text | color_modify: 'alpha', 0.23 }};
    --zf-placeholder: {{ c_text | color_modify: 'alpha', 0.5 }};
    --zf-field-bg: {{ c_text | color_modify: 'alpha', 0.035 }};
    --zf-btn-bg: {{ section.settings.color_button_bg }};
    --zf-btn-text: {{ section.settings.color_button }};
    --zf-divider: {{ c_border | color_modify: 'alpha', 0.2 }};
    --zf-bubble: {{ section.settings.color_card | color_modify: 'alpha', 0.1 }};
    --zf-cols: {{ cols }};
    --zf-gap: 0px;
    --zf-max: {{ section.settings.max_width }}px;
    --zf-body: {{ section.settings.body_font_size }}px;
    --zf-font: {{ section.settings.font_family }};

    box-sizing: border-box;
    width: 100%;
    font-family: var(--zf-font);
  }
  #shopify-section-{{ section.id }} .zf *,
  #shopify-section-{{ section.id }} .zf *::before,
  #shopify-section-{{ section.id }} .zf *::after { box-sizing: border-box; }

  /* ---------- dark panel ---------- */
  #shopify-section-{{ section.id }} .zf__main {
    position: relative;
    overflow: hidden;
    background: var(--zf-bg);
    color: var(--zf-text);
    padding-top: {{ pt_base }}px;
    padding-bottom: {{ pb_base }}px;
  }

  /* ---------- watermark ---------- */
  #shopify-section-{{ section.id }} .zf__watermark-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 36px;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }
  #shopify-section-{{ section.id }} .zf__watermark {
    display: block;
    height: 210px;
    width: auto;
    max-width: none;
    border-radius: 0;
    opacity: {{ section.settings.watermark_opacity | divided_by: 100.0 }};
  }

  /* ---------- content shell (.zehn-desktop-layout-width) ---------- */
  #shopify-section-{{ section.id }} .zf__inner {
    position: relative;
    z-index: 10;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-left: 12px;
    padding-right: 12px;
  }
  #shopify-section-{{ section.id }} .zf__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--zf-gap);
  }

  /* ---------- brand column ---------- */
  #shopify-section-{{ section.id }} .zf__brand { margin-bottom: 24px; }
  #shopify-section-{{ section.id }} .zf__logo {
    display: block;
    height: 36px;
    width: auto;
    max-width: 100%;
    margin-bottom: 20px;
    border-radius: 0;
  }
  #shopify-section-{{ section.id }} .zf__logo-text {
    margin: 0 0 12px;
    font-family: var(--zf-font);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--zf-text);
  }

  /* ---------- newsletter ---------- */
  #shopify-section-{{ section.id }} .zf__newsletter { margin-bottom: 26px; }
  #shopify-section-{{ section.id }} .zf__label {
    display: block;
    margin: 0 0 12px;
    font-family: var(--zf-font);
    font-size: var(--zf-body);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--zf-text);
  }
  #shopify-section-{{ section.id }} .zf__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .zf__form { margin: 0; }
  #shopify-section-{{ section.id }} .zf__field {
    display: flex;
    align-items: stretch;
    width: 100%;
    background: var(--zf-field-bg);
    border: 1px solid var(--zf-rule);
    border-radius: {{ section.settings.field_radius }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .zf__field:focus-within { border-color: var(--zf-accent); }
  #shopify-section-{{ section.id }} .zf__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 10px 13px;
    font-family: var(--zf-font);
    font-size: 16px;
    line-height: 1.5;
    color: var(--zf-text);
    background: transparent;
    border: 0;
    border-right: 1px solid var(--zf-rule);
    border-radius: 0;
    -webkit-appearance: none;
    appearance: none;
  }
  #shopify-section-{{ section.id }} .zf__input::placeholder { color: var(--zf-placeholder); }
  #shopify-section-{{ section.id }} .zf__input:focus { outline: none; box-shadow: none; }
  #shopify-section-{{ section.id }} .zf__submit {
    flex: 0 0 auto;
    padding: 0 21px;
    font-family: var(--zf-font);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--zf-btn-text);
    background: var(--zf-btn-bg);
    border: 0;
    border-radius: 0;
    cursor: pointer;
    transition: background-color 300ms ease, color 300ms ease;
  }
  #shopify-section-{{ section.id }} .zf__submit:hover { color: var(--zf-accent); }
  #shopify-section-{{ section.id }} .zf__submit:focus-visible { outline: 2px solid var(--zf-accent); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .zf__message {
    margin: 8px 0 0;
    font-family: var(--zf-font);
    font-size: 14px;
    line-height: 1.4;
    color: var(--zf-accent);
  }
  #shopify-section-{{ section.id }} .zf__message--error { color: {{ section.settings.color_error }}; }

  /* ---------- socials ---------- */
  #shopify-section-{{ section.id }} .zf__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .zf__social {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--zf-bubble);
    color: var(--zf-link);
    text-decoration: none;
    transition: all 300ms ease;
  }
  #shopify-section-{{ section.id }} .zf__social:hover { text-decoration: none; }
  #shopify-section-{{ section.id }} .zf__social svg {
    width: 16px;
    height: 16px;
    display: block;
  }
  /* brand hover colours — exactly as BRAND_HOVER_COLORS in Footer.tsx */
  #shopify-section-{{ section.id }} .zf__social--facebook:hover { color: #1877F2; }
  #shopify-section-{{ section.id }} .zf__social--instagram:hover { color: #E1306C; }
  #shopify-section-{{ section.id }} .zf__social--tiktok:hover { color: #000000; }
  #shopify-section-{{ section.id }} .zf__social--linkedin:hover { color: #0077B5; }
  #shopify-section-{{ section.id }} .zf__social--youtube:hover { color: #FF0000; }
  #shopify-section-{{ section.id }} .zf__social--pinterest:hover { color: #E60023; }

  /* ---------- menu columns / accordion ---------- */
  #shopify-section-{{ section.id }} .zf__col { border-bottom: 1px solid var(--zf-divider); }
  #shopify-section-{{ section.id }} .zf__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 16px 0;
    background: transparent;
    border: 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
    font-family: var(--zf-font);
  }
  #shopify-section-{{ section.id }} .zf__heading {
    margin: 0;
    font-family: var(--zf-font);
    font-size: var(--zf-body);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--zf-text);
  }
  #shopify-section-{{ section.id }} .zf__chevron {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    color: var(--zf-chevron);
    transition: transform 300ms ease;
  }
  #shopify-section-{{ section.id }} .zf__toggle[aria-expanded='true'] .zf__chevron { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} .zf__panel {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height 300ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  #shopify-section-{{ section.id }} .zf__panel.is-open {
    max-height: 500px;
    opacity: 1;
    padding-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .zf__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .zf__links li { margin: 0; }
  #shopify-section-{{ section.id }} .zf__links li + li { margin-top: 8px; }
  #shopify-section-{{ section.id }} .zf__link {
    display: inline-block;
    padding: 4px 0;
    font-family: var(--zf-font);
    font-size: var(--zf-body);
    line-height: 1.5;
    color: var(--zf-link);
    text-decoration: none;
    transition: all 300ms ease;
  }
  #shopify-section-{{ section.id }} .zf__link:hover { color: var(--zf-accent); text-decoration: none; }
  #shopify-section-{{ section.id }} .zf__link--external {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  #shopify-section-{{ section.id }} .zf__link--external svg {
    width: 12px;
    height: 12px;
    opacity: 0.6;
    flex: 0 0 auto;
  }

  /* ---------- bottom band (bg-card) ---------- */
  #shopify-section-{{ section.id }} .zf__bottom {
    width: 100%;
    background: {{ section.settings.color_card }};
  }
  #shopify-section-{{ section.id }} .zf__payments {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 24px 24px 16px;
  }
  #shopify-section-{{ section.id }} .zf__payment {
    display: block;
    height: 20px;
    width: auto;
    border-radius: 0;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .zf__payments svg {
    height: 20px;
    width: auto;
    display: block;
  }
  #shopify-section-{{ section.id }} .zf__legal {
    padding: 8px 24px 24px;
    text-align: center;
    font-family: var(--zf-font);
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.color_legal }};
    font-weight:500;
  }
  #shopify-section-{{ section.id }} .zf__legal p { margin: 0; }
  #shopify-section-{{ section.id }} .zf__legal p + p,
  #shopify-section-{{ section.id }} .zf__legal div + p { margin-top: 4px; }
  #shopify-section-{{ section.id }} .zf__legal--desktop { display: none; }

  /* ---------- sm: {{ bp }}px (Tailwind `sm:`) ---------- */
  @media screen and (min-width: {{ bp }}px) {
    #shopify-section-{{ section.id }} .zf {
      --zf-gap: {{ gap_sm }}px;
    }
    #shopify-section-{{ section.id }} .zf__main {
      padding-top: {{ pt_sm }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #shopify-section-{{ section.id }} .zf__inner {
      padding-left: 24px;
      padding-right: 24px;
    }
    #shopify-section-{{ section.id }} .zf__watermark-wrap {
      align-items: center;
      padding-bottom: 0;
    }
    #shopify-section-{{ section.id }} .zf__watermark { height: 250px; }
    #shopify-section-{{ section.id }} .zf__grid {
      grid-template-columns: repeat(var(--zf-cols), minmax(0, 1fr));
    }
    #shopify-section-{{ section.id }} .zf__brand { margin-bottom: 0; }
    #shopify-section-{{ section.id }} .zf__logo { height: 44px; margin-bottom: 28px; }
    #shopify-section-{{ section.id }} .zf__input { font-size: 14px; }
    #shopify-section-{{ section.id }} .zf__newsletter { margin-bottom: 26px; }
    #shopify-section-{{ section.id }} .zf__socials { gap: 12px; }
    #shopify-section-{{ section.id }} .zf__social { width: 48px; height: 48px; }
    #shopify-section-{{ section.id }} .zf__social svg { width: 20px; height: 20px; }
    #shopify-section-{{ section.id }} .zf__col { border-bottom: 0; }
    #shopify-section-{{ section.id }} .zf__toggle {
      padding: 0;
      margin-bottom: 16px;
      cursor: default;
      pointer-events: none;
    }
    #shopify-section-{{ section.id }} .zf__chevron { display: none; }
    #shopify-section-{{ section.id }} .zf__panel,
    #shopify-section-{{ section.id }} .zf__panel.is-open {
      max-height: none;
      opacity: 1;
      overflow: visible;
      padding-bottom: 0;
    }
    #shopify-section-{{ section.id }} .zf__links li + li { margin-top: 12px; }
    #shopify-section-{{ section.id }} .zf__payments { gap: 48px; padding: 40px 40px 16px; }
    #shopify-section-{{ section.id }} .zf__payment,
    #shopify-section-{{ section.id }} .zf__payments svg { height: 24px; }
    #shopify-section-{{ section.id }} .zf__legal { font-size: 14px; font-weight:700; padding-bottom: 32px; }
    #shopify-section-{{ section.id }} .zf__legal--mobile { display: none; }
    #shopify-section-{{ section.id }} .zf__legal--desktop { display: block; }
  }

  /* ---------- md: 768px ---------- */
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .zf__watermark { height: 350px; }
  }

  /* ---------- lg: 1024px ---------- */
  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .zf {
      --zf-gap: {{ section.settings.column_gap }}px;
    }
    #shopify-section-{{ section.id }} .zf__main {
      padding-top: {{ section.settings.padding_top }}px;
    }
    #shopify-section-{{ section.id }} .zf__watermark { height: {{ section.settings.watermark_height }}px; }
    #shopify-section-{{ section.id }} .zf__inner {
      width: min(95vw, var(--zf-max));
      max-width: var(--zf-max);
      padding-left: 0;
      padding-right: 0;
    }
    #shopify-section-{{ section.id }} .zf__payments { gap: 64px; padding-left: 80px; padding-right: 80px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .zf__panel,
    #shopify-section-{{ section.id }} .zf__chevron { transition: none !important; }
  }
</style>

<div class="zf" id="zf-{{ section.id }}">
  <div class="zf__main">

    {%- comment -%} ---------- giant background wordmark ---------- {%- endcomment -%}
    {%- if watermark_src != blank -%}
      <div class="zf__watermark-wrap">
        <img
          class="zf__watermark"
          src="{{ watermark_src }}"
          alt=""
          aria-hidden="true"
          width="1001"
          height="1309"
          loading="lazy"
          decoding="async"
        >
      </div>
    {%- endif -%}

    <div class="zf__inner">
      <div class="zf__grid">

        {%- comment -%} ---------- brand / newsletter / socials ---------- {%- endcomment -%}
        <div class="zf__brand">
          {%- if logo_src != blank -%}
            <img
              class="zf__logo"
              src="{{ logo_src }}"
              alt="{{ shop.name | escape }}"
              width="2163"
              height="840"
              loading="lazy"
              decoding="async"
            >
          {%- else -%}
            <p class="zf__logo-text">{{ shop.name }}</p>
          {%- endif -%}

          {%- if section.settings.show_newsletter -%}
            <div class="zf__newsletter">
              {%- if section.settings.newsletter_heading != blank -%}
                <h3 class="zf__label">{{ section.settings.newsletter_heading }}</h3>
              {%- endif -%}

              {%- form 'customer', class: 'zf__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="zf__visually-hidden" for="zf-email-{{ section.id }}">
                  {{ section.settings.newsletter_aria_label | default: 'E-Mail-Adresse für Newsletter' }}
                </label>
                <div class="zf__field">
                  <input
                    class="zf__input"
                  id="zf-email-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  required
                  {% if form.errors %}aria-invalid="true" aria-describedby="zf-msg-{{ section.id }}"{% endif %}
                >
                <button
                  class="zf__submit"
                  type="submit"
                  aria-label="{{ section.settings.newsletter_button_aria | default: 'Newsletter abonnieren' | escape }}"
                >
                  {{ section.settings.newsletter_button_label }}
                </button>
                </div>

                {%- if form.errors -%}
                  <p class="zf__message zf__message--error" id="zf-msg-{{ section.id }}" tabindex="-1">
                    {{ section.settings.newsletter_error }}
                  </p>
                {%- elsif form.posted_successfully? -%}
                  <p class="zf__message" id="zf-msg-{{ section.id }}" tabindex="-1">
                    {{ section.settings.newsletter_success }}
                  </p>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}

          <div class="zf__socials">
            {%- if section.settings.social_facebook != blank -%}
              <a class="zf__social zf__social--facebook" href="{{ section.settings.social_facebook | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_instagram != blank -%}
              <a class="zf__social zf__social--instagram" href="{{ section.settings.social_instagram | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_tiktok != blank -%}
              <a class="zf__social zf__social--tiktok" href="{{ section.settings.social_tiktok | escape }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V9.48a8.18 8.18 0 004.76 1.52V7.56a4.84 4.84 0 01-1-.87z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_linkedin != blank -%}
              <a class="zf__social zf__social--linkedin" href="{{ section.settings.social_linkedin | escape }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
              <a class="zf__social zf__social--youtube" href="{{ section.settings.social_youtube | escape }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_pinterest != blank -%}
              <a class="zf__social zf__social--pinterest" href="{{ section.settings.social_pinterest | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345c-.091.378-.293 1.194-.332 1.361-.053.218-.173.265-.4.159-1.492-.694-2.424-2.875-2.424-4.627 0-3.769 2.737-7.229 7.892-7.229 4.144 0 7.365 2.953 7.365 6.899 0 4.117-2.595 7.431-6.199 7.431-1.211 0-2.348-.63-2.738-1.373 0 0-.599 2.282-.744 2.84-.282 1.084-1.064 2.456-1.549 3.235 1.163.359 2.396.553 3.682.553 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%} ---------- menu columns (accordion on mobile) ---------- {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign menu = block.settings.menu
            assign heading = block.settings.heading
            if heading == blank and menu != blank
              assign heading = menu.title
            endif
          -%}
          <div class="zf__col" {{ block.shopify_attributes }}>
            <button
              class="zf__toggle"
              type="button"
              data-zf-toggle
              aria-expanded="false"
              aria-controls="zf-panel-{{ block.id }}"
              id="zf-heading-{{ block.id }}"
            >
              <h3 class="zf__heading">{{ heading }}</h3>
              <svg class="zf__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>

            <div
              class="zf__panel"
              id="zf-panel-{{ block.id }}"
              role="region"
              aria-labelledby="zf-heading-{{ block.id }}"
            >
              <ul class="zf__links">
                {%- if menu != blank -%}
                  {%- comment -%} A selected Shopify menu always wins {%- endcomment -%}
                  {%- for link in menu.links -%}
                    <li><a class="zf__link" href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- comment -%} Manual list: one per line, "Label | /path" — full URLs render as external {%- endcomment -%}
                  {%- assign rows = block.settings.links_text | strip | newline_to_br | split: '<br />' -%}
                  {%- for row in rows -%}
                    {%- assign line = row | strip -%}
                    {%- if line == blank -%}{%- continue -%}{%- endif -%}
                    {%- assign parts = line | split: '|' -%}
                    {%- assign label = parts[0] | strip -%}
                    {%- assign url = parts[1] | strip -%}
                    {%- if url == blank -%}{%- assign url = '#' -%}{%- endif -%}
                    <li>
                      {%- if url contains '://' -%}
                        <a
                          class="zf__link zf__link--external"
                          href="{{ url }}"
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="{{ label | escape }} (öffnet in neuem Tab)"
                        >
                          {{ label }}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6"/></svg>
                        </a>
                      {%- else -%}
                        <a class="zf__link" href="{{ url }}">{{ label }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          </div>
        {%- endfor -%}

      </div>
    </div>
  </div>

  {%- comment -%} ---------- payment + legal band ---------- {%- endcomment -%}
  <div class="zf__bottom">
    {%- if section.settings.show_payment_icons -%}
      <div class="zf__payments">
        {%- if section.settings.payment_assets != blank -%}
          {%- assign files = section.settings.payment_assets | split: ',' -%}
          {%- for file in files -%}
            {%- assign filename = file | strip -%}
            {%- if filename != blank -%}
              <img
                class="zf__payment"
                src="{{ filename | asset_url }}"
                alt="{{ filename | split: '.' | first | capitalize }}"
                width="96"
                height="32"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'zf__payment' }}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="zf__legal">
      {%- if section.settings.legal_text_mobile != blank -%}
        <div class="zf__legal--mobile">{{ section.settings.legal_text_mobile }}</div>
      {%- endif -%}
      {%- if section.settings.legal_text != blank -%}
        <div class="zf__legal--desktop">{{ section.settings.legal_text }}</div>
      {%- endif -%}
      {%- if section.settings.copyright_text != blank -%}
        <p>&copy; {{ year }} {{ section.settings.copyright_text }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('zf-{{ section.id }}');
    if (!root) return;

    var desktop = window.matchMedia('(min-width: {{ bp }}px)');
    var toggles = Array.prototype.slice.call(root.querySelectorAll('[data-zf-toggle]'));

    function panelFor(btn) {
      return document.getElementById(btn.getAttribute('aria-controls'));
    }

    function closeAll() {
      toggles.forEach(function (btn) {
        var panel = panelFor(btn);
        btn.setAttribute('aria-expanded', 'false');
        if (panel) panel.classList.remove('is-open');
      });
    }

    toggles.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (desktop.matches) return;
        var panel = panelFor(btn);
        if (!panel) return;
        var wasOpen = btn.getAttribute('aria-expanded') === 'true';
        closeAll(); /* single-open accordion, matching the Hydrogen `openSection` state */
        if (!wasOpen) {
          btn.setAttribute('aria-expanded', 'true');
          panel.classList.add('is-open');
        }
      });
    });

    if (desktop.addEventListener) {
      desktop.addEventListener('change', closeAll);
    } else if (desktop.addListener) {
      desktop.addListener(closeAll);
    }
  })();
</script>

