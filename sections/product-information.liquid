  /* ---------- size guide table ---------- */
  #shopify-section-{{ section.id }} .pp__sg-block { margin-bottom: 2rem; }
  #shopify-section-{{ section.id }} .pp__sg-block h3 {
    margin: 0 0 1rem;
    font-family: var(--pp-font-display);
