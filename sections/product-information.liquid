{%- comment -%}
  ZEHN — Product page (Hydrogen `products.$handle.tsx` → Shopify Liquid)
  Place in: sections/main-product.liquid
  Template: templates/product.json →
  {
    "sections": {
      "main": {
        "type": "main-product",
        "blocks": {
          "details": { "type": "details-popup", "settings": {} }
        },
        "block_order": ["details"]
      }
    },
    "order": ["main"]
  }

  ------------------------------------------------------------------
  CHANGE LOG (details popup extracted to a Horizon theme block)
  ------------------------------------------------------------------
  - The "Produktdetails ansehen" trigger and its modal have been REMOVED
    from this section. They now live in the standalone theme block
    blocks/details-popup.liquid.
  - This section opts in to theme blocks and renders them at
    {% content_for 'blocks' %}, placed where the trigger used to sit (in
    the product header). Add / remove / reorder the popup in the editor.
  - The header summary list split (description to bulleted summary) is
    unrelated to the popup and has been kept.
  - Removed: the details-modal markup, its dedicated CSS (description,
    slider, modal option and button styles, plus the old inline trigger
    styles) and its JS (variant-picker clone, open handler, modal slider,
    and the popup button label handling). The shared modal shell CSS is
    kept for the size-guide modal.
  Scope of the original conversion (unchanged, agreed with merchant):
  - Recommended-products section intentionally excluded.
  - Wishlist is localStorage-based (no wishlist app confirmed).
  - Color-grouped gallery images matched by filename group (alt-text
    fallback). No metafield/naming convention confirmed on Shopify side.
  - The "quick add" bag icon in the fullscreen viewer closes the viewer
    and scrolls to the main variant picker.
  - Combined-listings cross-product option links are not ported.
  - Meta/Google pixel calls are clearly-marked dataLayer stubs.
  - Materials / features / care copy comes from
    product.metafields.custom.* (namespace "custom"). Shipping copy is
    static, as it was in the Hydrogen file.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at = current_variant.compare_at_price
  assign is_on_sale = false
  if compare_at and compare_at > current_variant.price
    assign is_on_sale = true
  endif

  assign materials = product.metafields.custom.materials.value
  if materials == blank
    assign materials = 'Die genaue Materialzusammensetzung finden Sie auf dem Pflegeetikett des Artikels. Aussagen zu zertifizierten oder recycelten Materialien gelten nur, wenn sie für dieses Produkt ausdrücklich angegeben sind.'
  endif

  assign features = product.metafields.custom.features.value
  if features == blank
    assign features = 'Moderne, maßgeschneiderte Passform mit raffinierten Details. Verstärkte Nähte für langlebige Haltbarkeit. Funktionale Taschen mit sauberen Abschlüssen. Für vielseitiges Styling und ganztägigen Komfort.'
  endif

  assign care = product.metafields.custom.care.value
  if care == blank
    assign care = 'Maschinenwäsche kalt mit ähnlichen Farben. Im Trockner bei niedriger Temperatur oder an der Luft trocknen. Bei Bedarf kühl bügeln. Nicht bleichen. Pflegeetikett beachten.'
  endif

  assign shipping = 'Deutschland: Kostenloser Versand und kostenlose Rücksendung mit DHL. Lieferzeit: 2–3 Werktage. Europäische Union: Versand 5,99 € pro Bestellung, Lieferzeit 3–5 Werktage; Rücksendung kostenlos.'

  assign all_products_url = routes.all_products_collection_url
-%}

<style>
  #shopify-section-{{ section.id }} .pp {
    --pp-fg: var(--color-foreground);
    --pp-primary: var(--color-primary);
    --pp-accent: var(--color-accent);
    --pp-border: var(--color-border);
    --pp-card: #ffffff;
    --pp-bg: var(--color-background);
    --pp-font-body: var(--font-body);
    --pp-font-display: var(--font-display);
    --pp-h2: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
    --pp-h3: 1.25rem;
    --pp-h4: 1.125rem;
    --pp-body: 1rem;
    --pp-body-lg: 1.125rem;

    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    background: var(--pp-bg);
    color: var(--pp-fg);
    font-family: var(--pp-font-body);
  }
  #shopify-section-{{ section.id }} .pp *,
  #shopify-section-{{ section.id }} .pp *::before,
  #shopify-section-{{ section.id }} .pp *::after { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .pp__main {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    padding: 0.875rem 0 2.5rem;
  }
  @media (min-width: 640px) {
    #shopify-section-{{ section.id }} .pp__main { padding: 1.5rem 0 4rem; }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pp__main { padding-bottom: 5rem; }
  }

  #shopify-section-{{ section.id }} .pp__shell {
    min-width: 0;
  }

  /* ---------- breadcrumb ---------- */
  #shopify-section-{{ section.id }} .pp__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--pp-fg) 55%, transparent);
  }
  #shopify-section-{{ section.id }} .pp__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .pp__breadcrumb a:hover { text-decoration: underline; }
  #shopify-section-{{ section.id }} .pp__breadcrumb span[aria-current] { color: var(--pp-fg); }

  /* ---------- layout ---------- */
  #shopify-section-{{ section.id }} .pp__layout {
    display: grid;
    min-width: 0;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pp__layout {
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
    }
  }

  /* ---------- gallery ---------- */
  #shopify-section-{{ section.id }} .pp__gallery { min-width: 0; }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pp__gallery {
      position: sticky;
      top: 7rem;
    }
  }
  #shopify-section-{{ section.id }} .pp__gallery-grid {
    display: grid;
    align-items: start;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pp__gallery-grid {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }

  #shopify-section-{{ section.id }} .pp__thumbs {
    display: none;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pp__thumbs {
      display: flex;
      flex-direction: column;
      grid-column: 1;
      grid-row: 1;
      width: 5rem;
      flex-shrink: 0;
      overflow: hidden;
      height: 72vh;
    }
  }
  #shopify-section-{{ section.id }} .pp__thumb-nav {
    display: flex;
    flex-shrink: 0;
    height: 1.25rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    align-self: center;
    background: none;
    border: 0;
