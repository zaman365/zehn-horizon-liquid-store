  #shopify-section-{{ section.id }} .pp__viewer-close svg { width: 2rem; height: 2rem; }

  #shopify-section-{{ section.id }} .pp__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pp * { transition: none !important; }
  }
</style>
<div class="pp" id="pp-{{ section.id }}" data-pp data-product-handle="{{ product.handle }}">
  <main class="pp__main">
    <div class="page-width pp__shell">

      {%- comment -%} ---------- breadcrumb ---------- {%- endcomment -%}
      <nav class="pp__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Startseite</a>
        <span aria-hidden="true">/</span>
        <a href="{{ all_products_url }}">Produkte</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ product.title }}</span>
      </nav>

      <div class="pp__layout">

        {%- comment -%} ================= GALLERY ================= {%- endcomment -%}
        {%- render 'product-media-gallery', product: product, current_variant: current_variant -%}

        {%- comment -%} ================= PRODUCT INFO ================= {%- endcomment -%}
        <div class="pp__info">
          <div class="pp__header">
            <span class="pp__vendor">{{ product.vendor | default: 'ZEHN Essentials' }}</span>
            <h1 class="pp__title">{{ product.title }}</h1>

            <div class="pp__summary" data-pp-summary hidden></div>

            {%- comment -%} Theme-block drop zone: the product details popup theme block renders its trigger and modal here. {%- endcomment -%}
            {% content_for 'blocks' %}

            <div class="pp__price-row">
              <span class="pp__price{% if is_on_sale %} is-sale{% endif %}" data-pp-price>{{ current_variant.price | money }}</span>
              <span class="pp__compare-price" data-pp-compare-price {% unless is_on_sale %}hidden{% endunless %}>{{ compare_at | money }}</span>
            </div>
          </div>

          {%- comment -%} ---------- variant picker ---------- {%- endcomment -%}
          {%- assign real_options = 0 -%}
          {%- for option in product.options_with_values -%}
            {%- unless option.name == 'Title' and option.values.size == 1 -%}
              {%- assign real_options = real_options | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}

          {%- if real_options > 0 -%}
            <div class="pp__options" data-pp-options>
              {%- for option in product.options_with_values -%}
                {%- if option.name == 'Title' and option.values.size == 1 -%}{%- continue -%}{%- endif -%}
                {%- assign option_name_lower = option.name | downcase -%}
                {%- assign is_color = false -%}
                {%- if option_name_lower == 'color' or option_name_lower == 'colour' or option_name_lower == 'farbe' -%}
                  {%- assign is_color = true -%}
                {%- endif -%}
                {%- assign is_size = false -%}
                {%- if option_name_lower == 'size' or option_name_lower == 'größe' or option_name_lower == 'groesse' -%}
                  {%- assign is_size = true -%}
                {%- endif -%}

                {%- assign option_index = option.position | minus: 1 -%}
                <fieldset class="pp__option" data-pp-option data-option-position="{{ option.position }}" data-option-name="{{ option.name | escape }}" {% if is_size %}data-size-option{% endif %}>
                  <legend class="pp__option-label">{{ option.name }}</legend>
                  <div class="pp__option-values{% if is_color %} pp__option-values--color{% endif %}" data-pp-option-values>
                    {%- for value in option.values -%}
                      {%- assign value_selected = false -%}
                      {%- if current_variant.options[option_index] == value.name -%}
                        {%- assign value_selected = true -%}
                      {%- endif -%}
                      <label>
                        <input
                          type="radio"
                          class="pp__value-input"
                          name="pp-option-{{ section.id }}-{{ option.position }}"
                          value="{{ value.name | escape }}"
                          data-pp-value-input
                          data-option-position="{{ option.position }}"
                          {% if value_selected %}checked{% endif %}
                          {% unless value.available %}disabled{% endunless %}
                        >
                        {%- if is_color -%}
                          {%- assign swatch_img = value.swatch.image | default: value.variant.featured_image -%}
                          <span class="pp__swatch{% unless value.available %} is-unavailable{% endunless %}" data-pp-value data-value="{{ value.name | escape }}">
                            {%- if swatch_img -%}
                              <img src="{{ swatch_img | image_url: width: 88 }}" alt="{{ value.name | escape }}" loading="lazy" width="44" height="44">
                            {%- elsif value.swatch.color -%}
                              <span class="pp__swatch-color" style="background-color: {{ value.swatch.color }};"></span>
                            {%- else -%}
                              <span class="pp__swatch-letter">{{ value.name | slice: 0, 1 | upcase }}</span>
                            {%- endif -%}
                            <svg class="pp__swatch-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                          </span>
                        {%- else -%}
                          <span class="pp__value{% unless value.available %} is-unavailable{% endunless %}" data-pp-value data-value="{{ value.name | escape }}">{{ value.name }}</span>
                        {%- endif -%}
                      </label>
                    {%- endfor -%}
                  </div>
                  {%- if is_size -%}
                    <button type="button" class="pp__show-more" data-pp-show-more aria-expanded="false" hidden>
                      <span data-pp-show-more-label>Weitere Größen anzeigen</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  {%- endif -%}
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment -%} ---------- buttons ---------- {%- endcomment -%}
          <div class="pp__buttons">
            <div class="pp__buttons-grid">
              <button
                type="button"
                class="pp__btn pp__btn--buy"
                data-pp-buy-now
                data-label-idle="Jetzt kaufen"
                data-label-soldout="Ausverkauft"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-pp-buy-now-label>{% if current_variant.available %}Jetzt kaufen{% else %}Ausverkauft{% endif %}</span>
              </button>
              <button
                type="button"
                class="pp__btn pp__btn--cart"
                data-pp-add-to-cart
                data-variant-id="{{ current_variant.id }}"
                data-label-idle="In den Warenkorb"
                data-label-soldout="Ausverkauft"
                data-label-added="Hinzugefügt"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-pp-add-to-cart-label>{% if current_variant.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</span>
              </button>
            </div>
          </div>

          {%- comment -%} ---------- benefits ---------- {%- endcomment -%}
          <div class="pp__benefits">
            <button type="button" class="pp__benefit pp__benefit--interactive" data-pp-open-size-guide>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7 12 3 4 7v10l8 4 8-4V7Z"/><path d="M12 3v18"/></svg>
              <span>Größenratgeber</span>
            </button>
            <div class="pp__benefit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3"/><path d="M14 9h4l4 4v4h-2"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/></svg>
              <span>Standardversand in DE kostenlos</span>
            </div>
            <div class="pp__benefit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
              <span>Einfache Rückgabe</span>
            </div>
            <div class="pp__benefit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5"/></svg>
              <span>Premium-Qualität</span>
            </div>
          </div>

          {%- comment -%} ---------- accordion ---------- {%- endcomment -%}
          <div class="pp__accordion">
            <div class="pp__accordion-item">
              <button type="button" class="pp__accordion-trigger" data-pp-accordion-trigger aria-expanded="true">
                <span>Materialien</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="pp__accordion-panel" data-pp-accordion-panel style="max-height: 500px;">
                <p>{{ materials }}</p>
              </div>
            </div>
            <div class="pp__accordion-item">
              <button type="button" class="pp__accordion-trigger" data-pp-accordion-trigger aria-expanded="false">
                <span>Eigenschaften</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="pp__accordion-panel" data-pp-accordion-panel style="max-height: 0;">
                <p>{{ features }}</p>
              </div>
            </div>
            <div class="pp__accordion-item">
              <button type="button" class="pp__accordion-trigger" data-pp-accordion-trigger aria-expanded="false">
                <span>Pflegehinweise</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="pp__accordion-panel" data-pp-accordion-panel style="max-height: 0;">
                <p>{{ care }}</p>
              </div>
            </div>
            <div class="pp__accordion-item">
              <button type="button" class="pp__accordion-trigger" data-pp-accordion-trigger aria-expanded="false">
                <span>Versand &amp; Rückgabe</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="pp__accordion-panel" data-pp-accordion-panel style="max-height: 0;">
                <p>{{ shipping }}</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  {%- comment -%} hidden source for the JS-driven summary/details split of descriptionHtml {%- endcomment -%}
  <template data-pp-description-source>{{ product.description }}</template>
  {%- comment -%} ================= SIZE GUIDE MODAL ================= {%- endcomment -%}
  <div class="pp__modal pp__modal--size" data-pp-modal="size-guide" aria-hidden="true">
    <button type="button" class="pp__modal-backdrop" data-pp-close-modal="size-guide" aria-label="Größenratgeber schließen"></button>
    <div class="pp__modal-panel" role="dialog" aria-modal="true" aria-label="Größenratgeber">
      <div class="pp__modal-head">
        <h2>Größenratgeber</h2>
        <div class="pp__modal-head-actions">
          <div class="pp__unit-toggle">
            <button type="button" class="pp__unit-btn is-active" data-pp-unit="cm">cm</button>
            <button type="button" class="pp__unit-btn" data-pp-unit="inch">inch</button>
          </div>
          <button type="button" class="pp__modal-close" data-pp-close-modal="size-guide" aria-label="Schließen">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      <div class="pp__modal-body">
        <div class="pp__sg-block">
          <h3>So messen Sie richtig</h3>
          <div class="pp__sg-grid">
            <div><h4>1. Brustumfang</h4><p>Messen Sie horizontal um die breiteste Stelle Ihrer Brust.</p></div>
            <div><h4>2. Taillenumfang</h4><p>Messen Sie um die schmalste Stelle Ihrer Taille.</p></div>
            <div><h4>3. Hüftumfang</h4><p>Messen Sie um die breiteste Stelle Ihrer Hüfte.</p></div>
            <div><h4>4. Innenbeinlänge</h4><p>Messen Sie vom Schritt bis zum Knöchel.</p></div>
          </div>
        </div>
        <div class="pp__sg-block">
          <h3 data-pp-sg-title>Größentabelle Oberteile</h3>
          <div class="pp__sg-table-wrap">
            <table class="pp__sg-table" data-pp-sg-table>
              <thead data-pp-sg-thead></thead>
              <tbody data-pp-sg-tbody></tbody>
            </table>
          </div>
        </div>
        <div class="pp__sg-tips">
          <h3>Tipps für die perfekte Passform</h3>
          <ul>
            <li>Messen Sie am besten über Ihrer Unterwäsche für genaue Ergebnisse</li>
            <li>Verwenden Sie ein flexibles Maßband und ziehen Sie es nicht zu fest</li>
            <li>Bei Zwischengrößen empfehlen wir die größere Größe für mehr Komfort</li>
            <li>Unsere Kleidung ist für eine moderne, leicht taillierte Passform konzipiert</li>
            <li>Bei Fragen zur Größe kontaktieren Sie gerne unseren Kundenservice</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ================= JSON-LD ================= {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | json }},
      "image": [{% for image in product.images %}{{ image | image_url: width: 1200 | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "sku": {{ current_variant.sku | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: "ZEHN" | json }}
      },
      "offers": {
        "@type": "Offer",
        "url": {{ canonical_url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ current_variant.price | divided_by: 100.0 | json }},
        "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "seller": {
          "@type": "Organization",
          "name": "VINCET GmbH",
          "alternateName": "ZEHN",
          "url": {{ shop.url | json }}
        }
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Startseite", "item": {{ shop.url | append: routes.root_url | json }} },
        { "@type": "ListItem", "position": 2, "name": "Produkte", "item": {{ shop.url | append: all_products_url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
      ]
    }
  </script>
  <script type="application/json" data-pp-product-json>{{ product | json }}</script>

  <script>
    (function () {
      var root = document.getElementById('pp-{{ section.id }}');
      if (!root) return;

      var productData = JSON.parse(root.querySelector('[data-pp-product-json]').textContent);
      var currentVariant =
        productData.variants.filter(function (v) { return v.id === {{ current_variant.id | json }}; })[0] ||
        productData.variants[0];

      function formatMoney(cents) {
        try {
          return (cents / 100).toLocaleString('de-DE', {
            style: 'currency',
            currency: {{ cart.currency.iso_code | json }},
          });
        } catch (e) {
          return (cents / 100).toFixed(2);
        }
      }

      function getColorPosition() {
        var names = ['color', 'colour', 'farbe'];
        var idx = -1;
        (productData.options || []).forEach(function (name, i) {
          if (idx === -1 && names.indexOf(name.toLowerCase()) !== -1) idx = i;
        });
        return idx === -1 ? null : idx;
      }

      /* ================= GALLERY ================= */
      var Gallery = (function () {
        var galleryJsonEl = root.querySelector('[data-pp-gallery-json]');
        var galleryData = galleryJsonEl ? JSON.parse(galleryJsonEl.textContent) : [];
        var mainImg = root.querySelector('[data-pp-main-img]');
        var viewerImg = root.querySelector('[data-pp-viewer-img]');
        var thumbBtns = Array.prototype.slice.call(root.querySelectorAll('[data-pp-thumb]'));
        var dots = Array.prototype.slice.call(root.querySelectorAll('[data-pp-dot]'));
        var mainImageEl = root.querySelector('[data-pp-main-image]');
        var thumbRail = root.querySelector('[data-pp-thumb-rail]');
        var visible = galleryData.map(function (_, i) { return i; });
        var current = 0;
        var autoTimer = null;
        var didSwipe = false;
        var touchStartX = 0;

        function applyImage(imgEl, item, sizesAttr) {
          if (!imgEl || !item) return;
          imgEl.src = item.src1200;
          imgEl.srcset = item.src400 + ' 400w, ' + item.src600 + ' 600w, ' + item.src800 + ' 800w, ' + item.src1200 + ' 1200w';
          if (sizesAttr) imgEl.sizes = sizesAttr;
          imgEl.alt = item.alt || '';
        }

        function show(index) {
          if (!galleryData.length) return;
          if (visible.indexOf(index) === -1) index = visible[0] || 0;
          current = index;
          var item = galleryData[index];
          applyImage(mainImg, item, '(min-width: 1024px) 547px, 100vw');
          applyImage(viewerImg, item, null);
          thumbBtns.forEach(function (btn) { btn.classList.toggle('is-active', Number(btn.dataset.index) === index); });
          dots.forEach(function (dot) { dot.classList.toggle('is-active', Number(dot.dataset.index) === index); });
          var activeThumb = thumbRail && thumbRail.querySelector('[data-index="' + index + '"]');
          if (activeThumb) activeThumb.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }

        /* Alt text is not a reliable grouping key (merchants mis-tag it, and it
         * rarely contains the exact option value). Filenames are: Shopify keeps
         * the uploaded name, and each variant's own featured_image tells us
         * which filename group that colour belongs to. So: read the variant's
         * featured image, take its filename group token, and show every image
         * sharing it. Alt text is only a fallback. */
        var productImageUrls = productData.images || [];

        function fileGroup(url) {
          if (!url) return '';
          var name = url.split('?')[0].split('/').pop().replace(/\.[a-z0-9]+$/i, '');
          var m = name.match(/^([A-Za-z]+)/);
          return (m ? m[1] : name).toLowerCase();
        }

        function normalize(str) {
          return (str || '').toLowerCase().replace(/[^a-z0-9]/g, '');
        }

        function indexesForVariant(variant) {
          var all = galleryData.map(function (_, i) { return i; });

          /* 1. Preferred: group by the filename of the variant's featured image. */
          var anchor = variant && variant.featured_image && variant.featured_image.src;
          if (anchor) {
            var group = fileGroup(anchor);
            if (group) {
              var byFile = [];
              productImageUrls.forEach(function (url, i) {
                if (fileGroup(url) === group) byFile.push(i);
              });
              if (byFile.length) return byFile;
            }
          }

          /* 2. Fallback: normalized alt-text match on the colour value, then on
           *    each word of it (handles "City Slate" vs "cityslate"). */
          var colorPos = getColorPosition();
          var colorValue = colorPos != null && variant ? variant.options[colorPos] : null;
          if (colorValue) {
            var candidates = [normalize(colorValue)];
            colorValue.split(/[\s\-_/]+/).forEach(function (word) {
              if (word.length >= 3) candidates.push(normalize(word));
            });
            for (var c = 0; c < candidates.length; c++) {
              if (!candidates[c]) continue;
              var byAlt = [];
              galleryData.forEach(function (item, i) {
                if (normalize(item.alt).indexOf(candidates[c]) !== -1) byAlt.push(i);
              });
              if (byAlt.length) return byAlt;
            }
          }

          /* 3. Nothing matched — show the whole gallery. */
          return all;
        }

        function filterByVariant(variant) {
          visible = indexesForVariant(variant);
          thumbBtns.forEach(function (btn, i) { btn.style.display = visible.indexOf(i) === -1 ? 'none' : ''; });
          dots.forEach(function (dot, i) { dot.style.display = visible.indexOf(i) === -1 ? 'none' : ''; });
          /* Matches the Hydrogen behaviour of resetting to the first image of
           * the colour group whenever the selected colour changes. */
          show(visible.length ? visible[0] : 0);
          restartAutoSlide();
        }

        function next() {
          if (!visible.length) return;
          var pos = visible.indexOf(current);
          show(visible[(pos + 1) % visible.length]);
        }
        function prev() {
          if (!visible.length) return;
          var pos = visible.indexOf(current);
          show(visible[(pos - 1 + visible.length) % visible.length]);
        }

        thumbBtns.forEach(function (btn) {
          btn.addEventListener('click', function () { show(Number(btn.dataset.index)); });
        });
        dots.forEach(function (dot) {
          dot.addEventListener('click', function () { show(Number(dot.dataset.index)); });
        });

        var thumbUp = root.querySelector('[data-pp-thumb-scroll="up"]');
        var thumbDown = root.querySelector('[data-pp-thumb-scroll="down"]');
        function scrollRail(dir) {
          if (!thumbRail) return;
          var first = thumbRail.querySelector('button');
          var amount = first ? first.offsetHeight + 12 : 132;
          thumbRail.scrollBy({ top: dir === 'up' ? -amount : amount, behavior: 'smooth' });
        }
        if (thumbUp) thumbUp.addEventListener('click', function () { scrollRail('up'); });
        if (thumbDown) thumbDown.addEventListener('click', function () { scrollRail('down'); });

        if (mainImageEl) {
          mainImageEl.addEventListener('touchstart', function (e) {
            didSwipe = false;
            touchStartX = e.touches[0].clientX;
          }, { passive: true });
          mainImageEl.addEventListener('touchmove', function (e) {
            if (Math.abs(touchStartX - e.touches[0].clientX) > 50) didSwipe = true;
          }, { passive: true });
          mainImageEl.addEventListener('touchend', function (e) {
            var touch = e.changedTouches[0];
            var delta = touch ? touchStartX - touch.clientX : 0;
            if (visible.length > 1) {
              if (delta > 50) next();
              else if (delta < -50) prev();
            }
          });
          var openViewer = function () {
            if (didSwipe) return;
            Viewer.open(current);
          };
          mainImageEl.addEventListener('click', openViewer);
          mainImageEl.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              openViewer();
            }
          });
        }

        function restartAutoSlide() {
          clearInterval(autoTimer);
          if (visible.length <= 1) return;
          autoTimer = setInterval(function () {
            var viewerEl = root.querySelector('[data-pp-viewer]');
            if (viewerEl && viewerEl.classList.contains('is-open')) return;
            next();
          }, 10000);
        }
        restartAutoSlide();

        /* Match the thumbnail column height to the main image, as the Hydrogen
         * version did with a ResizeObserver. Desktop only — the rail is hidden
         * below 1024px, where the CSS fallback height is irrelevant. */
        var thumbsEl = root.querySelector('[data-pp-thumbs]');
        if (thumbsEl && mainImageEl) {
          var syncThumbHeight = function () {
            if (window.matchMedia('(min-width: 1024px)').matches) {
              var h = mainImageEl.getBoundingClientRect().height;
              if (h > 0) thumbsEl.style.height = h + 'px';
            } else {
              thumbsEl.style.height = '';
            }
          };
          syncThumbHeight();
          if (typeof ResizeObserver !== 'undefined') {
            new ResizeObserver(syncThumbHeight).observe(mainImageEl);
          } else {
            window.addEventListener('resize', syncThumbHeight);
          }
        }

        return {
          filterByVariant: filterByVariant,
          show: show,
          next: next,
          prev: prev,
          getCurrent: function () { return current; },
          restartAutoSlide: restartAutoSlide,
        };
      })();

      /* ================= FULLSCREEN VIEWER ================= */
      var Viewer = (function () {
        var el = root.querySelector('[data-pp-viewer]');
        var prevBtn = root.querySelector('[data-pp-viewer-prev]');
        var nextBtn = root.querySelector('[data-pp-viewer-next]');
        var closeBtn = root.querySelector('[data-pp-close-viewer]');
        var bagBtn = root.querySelector('[data-pp-viewer-bag]');
        var frame = root.querySelector('[data-pp-viewer-frame]');
        var touchStart = null;

        function open(index) {
          Gallery.show(index);
          el.classList.add('is-open');
          el.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
        function close() {
          el.classList.remove('is-open');
          el.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          Gallery.restartAutoSlide();
        }

        if (prevBtn) prevBtn.addEventListener('click', function () { Gallery.prev(); });
        if (nextBtn) nextBtn.addEventListener('click', function () { Gallery.next(); });
        if (closeBtn) closeBtn.addEventListener('click', close);
        if (el) el.addEventListener('click', function (e) { if (e.target === el) close(); });

        if (bagBtn) {
          bagBtn.addEventListener('click', function () {
            close();
            var optionsEl = root.querySelector('[data-pp-options]');
            if (optionsEl) optionsEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        }

        document.addEventListener('keydown', function (e) {
          if (!el || !el.classList.contains('is-open')) return;
          if (e.key === 'Escape') close();
          if (e.key === 'ArrowLeft') Gallery.prev();
          if (e.key === 'ArrowRight') Gallery.next();
        });

        if (frame) {
          frame.addEventListener('touchstart', function (e) {
            var t = e.touches[0];
            touchStart = { x: t.clientX, y: t.clientY };
          }, { passive: true });
          frame.addEventListener('touchend', function (e) {
            if (!touchStart) return;
            var t = e.changedTouches[0];
            var dx = touchStart.x - t.clientX;
            var dy = touchStart.y - t.clientY;
            touchStart = null;
            if (Math.abs(dy) > 56 && Math.abs(dy) > Math.abs(dx)) { close(); return; }
            if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
              if (dx > 0) Gallery.next(); else Gallery.prev();
            }
          });
        }

        return { open: open, close: close };
      })();

      /* ================= WISHLIST (localStorage) ================= */
      var WISHLIST_KEY = 'zehn:wishlist';
      function getWishlist() {
        try { return JSON.parse(localStorage.getItem(WISHLIST_KEY) || '[]'); } catch (e) { return []; }
      }
      function setWishlist(list) {
        try { localStorage.setItem(WISHLIST_KEY, JSON.stringify(list)); } catch (e) {}
      }
      function isInWishlist(handle) { return getWishlist().indexOf(handle) !== -1; }
      function toggleWishlist(handle) {
        var list = getWishlist();
        var idx = list.indexOf(handle);
        if (idx === -1) list.push(handle); else list.splice(idx, 1);
        setWishlist(list);
        return idx === -1;
      }
      function syncWishlistButtons() {
        var active = isInWishlist(root.dataset.productHandle);
        root.querySelectorAll('[data-pp-wishlist]').forEach(function (btn) {
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-label', active ? 'Von Wunschliste entfernen' : 'Zur Wunschliste hinzufügen');
        });
      }
      root.querySelectorAll('[data-pp-wishlist]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          toggleWishlist(root.dataset.productHandle);
          syncWishlistButtons();
        });
      });
      syncWishlistButtons();

      /* ================= DESCRIPTION SUMMARY / DETAILS SPLIT ================= */
      /* Extracts the first list from the product description into the header
       * summary. The product-details popup that used to consume the rest of
       * the description now lives in the standalone details-popup theme block. */
      function initDescriptionSplit() {
        var source = root.querySelector('[data-pp-description-source]');
        var summaryEl = root.querySelector('[data-pp-summary]');
        if (!source) return;

        var wrapper = document.createElement('div');
        wrapper.innerHTML = source.innerHTML;

        var list = wrapper.querySelector('ul, ol');
        if (list && summaryEl) {
          summaryEl.innerHTML = list.outerHTML;
          summaryEl.hidden = false;
        }
      }
      initDescriptionSplit();

      /* ================= ACCORDION ================= */
      root.querySelectorAll('[data-pp-accordion-trigger]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var panel = btn.nextElementSibling;
          var isOpen = btn.getAttribute('aria-expanded') === 'true';
          root.querySelectorAll('[data-pp-accordion-trigger]').forEach(function (other) {
            other.setAttribute('aria-expanded', 'false');
            other.nextElementSibling.style.maxHeight = '0px';
          });
          if (!isOpen) {
            btn.setAttribute('aria-expanded', 'true');
            panel.style.maxHeight = panel.scrollHeight + 'px';
          }
        });
      });
      var openTrigger = root.querySelector('[data-pp-accordion-trigger][aria-expanded="true"]');
      if (openTrigger) openTrigger.nextElementSibling.style.maxHeight = openTrigger.nextElementSibling.scrollHeight + 'px';

      /* ================= SIZE SORT + COLLAPSE ================= */
      var SIZE_ORDER = ['XXS', 'XS', 'S', 'M', 'L', 'XL', 'XXL', '2XL', 'XXXL', '3XL', '4XL', '5XL'];
      function sizeSortValue(name) {
        var n = (name || '').toUpperCase().replace(/\s+/g, '');
        var idx = SIZE_ORDER.indexOf(n);
        if (idx >= 0) return idx;
        var waist = n.match(/(\d+)W/);
        var length = n.match(/(\d+)L/);
        var numeric = n.match(/^(\d+)$/);
        if (waist) return 100 + Number(waist[1]) * 100 + (length ? Number(length[1]) : 0);
        if (numeric) return 100 + Number(numeric[1]) * 100;
        return Number.MAX_SAFE_INTEGER;
      }

      function initSizeOption(fieldset) {
        var container = fieldset.querySelector('[data-pp-option-values]');
        if (!container) return;
        var labels = Array.prototype.slice.call(container.children);
        labels.sort(function (a, b) {
          var an = a.querySelector('[data-pp-value-input]').value;
          var bn = b.querySelector('[data-pp-value-input]').value;
          var diff = sizeSortValue(an) - sizeSortValue(bn);
          if (diff !== 0) return diff;
          return an.localeCompare(bn, 'de', { numeric: true, sensitivity: 'base' });
        });
        labels.forEach(function (label) { container.appendChild(label); });

        var showMoreBtn = fieldset.querySelector('[data-pp-show-more]');
        if (!showMoreBtn) return;
        if (labels.length <= 8) { showMoreBtn.hidden = true; return; }

        var selectedIndex = labels.findIndex(function (label) {
          return label.querySelector('[data-pp-value-input]').checked;
        });

        function applyCollapse(expanded) {
          labels.forEach(function (label, i) {
            var visible = expanded || i < 8 || (selectedIndex >= 8 && i === selectedIndex);
            label.style.display = visible ? '' : 'none';
          });
          showMoreBtn.setAttribute('aria-expanded', expanded);
          showMoreBtn.querySelector('[data-pp-show-more-label]').textContent = expanded
            ? 'Weniger Größen anzeigen'
            : 'Weitere Größen anzeigen (' + (labels.length - 8) + ')';
        }

        showMoreBtn.hidden = false;
        applyCollapse(false);
        showMoreBtn.addEventListener('click', function () {
          applyCollapse(showMoreBtn.getAttribute('aria-expanded') !== 'true');
        });
      }
      root.querySelectorAll('[data-pp-option][data-size-option]').forEach(initSizeOption);

      /* ================= VARIANT SELECTION ================= */
      function getCurrentSelection() {
        var selection = [];
        root.querySelectorAll('[data-pp-value-input]').forEach(function (input) {
          if (input.checked) {
            var pos = parseInt(input.dataset.optionPosition, 10);
            selection[pos - 1] = input.value;
          }
        });
        return selection;
      }

      function isValueAvailable(position, valueName, selection) {
        return productData.variants.some(function (v) {
          if (v.options[position - 1] !== valueName) return false;
          if (!v.available) return false;
          return selection.every(function (val, idx) {
            if (idx === position - 1) return true;
            if (val == null) return true;
            return v.options[idx] === val;
          });
        });
      }

      function refreshAvailability() {
        var selection = getCurrentSelection();
        root.querySelectorAll('[data-pp-option]').forEach(function (fieldset) {
          var position = parseInt(fieldset.dataset.optionPosition, 10);
          fieldset.querySelectorAll('[data-pp-value-input]').forEach(function (input) {
            var available = isValueAvailable(position, input.value, selection);
            input.disabled = !available;
            var labelEl = input.nextElementSibling;
            if (labelEl) labelEl.classList.toggle('is-unavailable', !available);
          });
        });
      }

      function findVariantForSelection(selection) {
        return productData.variants.filter(function (v) {
          return v.options.every(function (val, idx) { return val === selection[idx]; });
        })[0];
      }

      /* Label helpers: read the admin-editable strings straight off each
       * button's data-label-* attributes, falling back to the original German
       * defaults. This is what lets the popup's button labels differ from the
       * main buttons' while still sharing the same JS. */
      function labelIdle(btn, fallback) { return btn.getAttribute('data-label-idle') || fallback; }
      function labelSoldOut(btn, fallback) { return btn.getAttribute('data-label-soldout') || fallback; }
      function labelAdded(btn, fallback) { return btn.getAttribute('data-label-added') || fallback; }

      function applyVariant(variant) {
        if (!variant) return;
        currentVariant = variant;
        var onSale = !!(variant.compare_at_price && variant.compare_at_price > variant.price);

        root.querySelectorAll('[data-pp-price]').forEach(function (el) {
          el.textContent = formatMoney(variant.price);
          el.classList.toggle('is-sale', onSale);
        });
        root.querySelectorAll('[data-pp-compare-price]').forEach(function (el) {
          el.hidden = !onSale;
          if (onSale) el.textContent = formatMoney(variant.compare_at_price);
        });

        root.querySelectorAll('[data-pp-buy-now]').forEach(function (btn) {
          btn.disabled = !variant.available;
          var span = btn.querySelector('span');
          if (span) {
            span.textContent = variant.available
              ? labelIdle(btn, 'Jetzt kaufen')
              : labelSoldOut(btn, 'Ausverkauft');
          }
        });
        root.querySelectorAll('[data-pp-add-to-cart]').forEach(function (btn) {
          btn.disabled = !variant.available;
          btn.dataset.variantId = variant.id;
          var span = btn.querySelector('span');
          if (span && !btn.classList.contains('is-added')) {
            span.textContent = variant.available
              ? labelIdle(btn, 'In den Warenkorb')
              : labelSoldOut(btn, 'Ausverkauft');
          }
        });

        try {
          var params = new URLSearchParams(window.location.search);
          (productData.options || []).forEach(function (name, idx) {
            if (variant.options[idx]) params.set(name, variant.options[idx]);
          });
          window.history.replaceState({}, '', window.location.pathname + '?' + params.toString());
        } catch (e) {}

        Gallery.filterByVariant(variant);
      }

      root.addEventListener('change', function (e) {
        var input = e.target.closest('[data-pp-value-input]');
        if (!input) return;
        refreshAvailability();
        var selection = getCurrentSelection();
        if (selection.length === (productData.options || []).length && selection.every(function (v) { return v != null; })) {
          applyVariant(findVariantForSelection(selection));
        }
      });
      refreshAvailability();

      Gallery.filterByVariant(currentVariant);

      /* ================= MODALS ================= */
      function openModal(name) {
        var modal = root.querySelector('[data-pp-modal="' + name + '"]');
        if (!modal) return;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function closeModal(name) {
        var modal = root.querySelector('[data-pp-modal="' + name + '"]');
        if (!modal) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      root.querySelectorAll('[data-pp-close-modal]').forEach(function (btn) {
        btn.addEventListener('click', function () { closeModal(btn.dataset.ppCloseModal); });
      });

      /* ---- size guide modal ---- */
      var sizeGuideUnit = 'cm';
      var SIZE_MAP_CM = { XS: ['86-91', '71-76', '81-84'], S: ['91-96', '76-81', '84-87'], M: ['96-101', '81-86', '87-90'], L: ['101-106', '86-91', '90-93'], XL: ['106-111', '91-96', '93-96'], XXL: ['111-117', '96-102', '96-99'] };
      var SIZE_MAP_INCH = { XS: ['34-36', '28-30', '32-33'], S: ['36-38', '30-32', '33-34'], M: ['38-40', '32-34', '34-35'], L: ['40-42', '34-36', '35-37'], XL: ['42-44', '36-38', '37-38'], XXL: ['44-46', '38-40', '38-39'] };

      function buildSizeGuide() {
        var unit = sizeGuideUnit;
        var sizeOptionNames = ['size', 'größe', 'groesse', 'waist'];
        var sizeOptionIndex = -1;
        (productData.options || []).forEach(function (name, idx) {
          if (sizeOptionIndex === -1 && sizeOptionNames.indexOf(name.toLowerCase()) !== -1) sizeOptionIndex = idx;
        });

        var sizes = [];
        if (sizeOptionIndex !== -1) {
          var seen = {};
          productData.variants.forEach(function (v) {
            var val = v.options[sizeOptionIndex];
            if (val && !seen[val]) { seen[val] = true; sizes.push(val); }
          });
        }

        var isPants = sizes.some(function (s) { return s.indexOf('W') !== -1 || s.indexOf('/') !== -1; });
        var titleEl = root.querySelector('[data-pp-sg-title]');
        var thead = root.querySelector('[data-pp-sg-thead]');
        var tbody = root.querySelector('[data-pp-sg-tbody]');
        var rows;

        if (sizes.length) {
          titleEl.textContent = isPants ? 'Größentabelle Hosen & Jeans' : 'Größentabelle Oberteile';
          rows = sizes.map(function (size) {
            if (isPants) {
              var match = size.match(/(\d+)W/i);
              var waistSize = match ? parseInt(match[1], 10) : parseInt(size, 10);
              if (unit === 'cm') {
                var waistCm = Math.round(waistSize * 2.54);
                var hipCm = Math.round((waistSize + 6) * 2.54);
                var inseamCm = size.indexOf('/') !== -1 ? Math.round(parseInt(size.split('/')[1], 10) * 2.54) : '76-81';
                return { size: size, a: (waistCm - 3) + '-' + waistCm, b: (hipCm - 3) + '-' + hipCm, c: inseamCm };
              }
              var hipInch = waistSize + 6;
              var inseamInch = size.indexOf('/') !== -1 ? size.split('/')[1] : '30-32';
              return { size: size, a: (waistSize - 2) + '-' + waistSize, b: (hipInch - 2) + '-' + hipInch, c: inseamInch };
            }
            var map = unit === 'cm' ? SIZE_MAP_CM : SIZE_MAP_INCH;
            var vals = map[size.toUpperCase()] || ['-', '-', '-'];
            return { size: size, a: vals[0], b: vals[1], c: vals[2] };
          });
        } else {
          isPants = false;
          titleEl.textContent = 'Oberteile (Hemden, T-Shirts, Pullover)';
          var map2 = unit === 'cm' ? SIZE_MAP_CM : SIZE_MAP_INCH;
          rows = ['XS', 'S', 'M', 'L', 'XL', 'XXL'].map(function (size) {
            var vals = map2[size];
            return { size: size, a: vals[0], b: vals[1], c: vals[2] };
          });
        }

        var col1 = isPants ? 'Taillenumfang' : 'Brustumfang';
        var col2 = isPants ? 'Hüftumfang' : 'Taillenumfang';
        var col3 = isPants ? 'Innenbeinlänge' : 'Ärmellänge';
        thead.innerHTML = '<tr><th>Größe</th><th>' + col1 + ' (' + unit + ')</th><th>' + col2 + ' (' + unit + ')</th><th>' + col3 + ' (' + unit + ')</th></tr>';
        tbody.innerHTML = rows.map(function (r) {
          return '<tr><td>' + r.size + '</td><td>' + r.a + '</td><td>' + r.b + '</td><td>' + r.c + '</td></tr>';
        }).join('');
      }

      var openSizeGuideBtn = root.querySelector('[data-pp-open-size-guide]');
      if (openSizeGuideBtn) {
        openSizeGuideBtn.addEventListener('click', function () {
          buildSizeGuide();
          openModal('size-guide');
        });
      }
      root.querySelectorAll('[data-pp-unit]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          sizeGuideUnit = btn.dataset.ppUnit;
          root.querySelectorAll('[data-pp-unit]').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
          buildSizeGuide();
        });
      });

      /* ================= CART ACTIONS ================= */
      function addToCart(btn) {
        if (btn.disabled || !currentVariant) return;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: currentVariant.id, quantity: 1 }] }),
        })
          .then(function (res) {
            if (!res.ok) throw new Error('Add to cart failed');
            return res.json();
          })
          .then(function () {
            document.dispatchEvent(new CustomEvent('cart:refresh'));
            var buttons = root.querySelectorAll('[data-pp-add-to-cart]');
            buttons.forEach(function (b) {
              b.classList.add('is-added');
              var span = b.querySelector('span');
              if (span) span.textContent = labelAdded(b, 'Hinzugefügt');
            });
            setTimeout(function () {
              buttons.forEach(function (b) {
                b.classList.remove('is-added');
                var span = b.querySelector('span');
                if (span) span.textContent = currentVariant.available
                  ? labelIdle(b, 'In den Warenkorb')
                  : labelSoldOut(b, 'Ausverkauft');
              });
            }, 2000);

            /* Wire this to your existing GTM / Meta Pixel setup */
            if (window.dataLayer) {
              window.dataLayer.push({
                event: 'add_to_cart',
                ecommerce: {
                  value: currentVariant.price / 100,
                  currency: {{ cart.currency.iso_code | json }},
                  items: [{ item_id: currentVariant.sku, item_name: {{ product.title | json }}, price: currentVariant.price / 100, quantity: 1 }],
                },
              });
            }
          })
          .catch(function (err) { console.error(err); });
      }
      root.querySelectorAll('[data-pp-add-to-cart]').forEach(function (btn) {
        btn.addEventListener('click', function () { addToCart(btn); });
      });

      function buyNow(btn) {
        if (btn.disabled || !currentVariant || !currentVariant.available) return;
        /* Wire this to your existing GTM / Meta Pixel setup */
        if (window.dataLayer) {
          window.dataLayer.push({
            event: 'begin_checkout',
            ecommerce: {
              value: currentVariant.price / 100,
              currency: {{ cart.currency.iso_code | json }},
              items: [{ item_id: currentVariant.sku, item_name: {{ product.title | json }}, price: currentVariant.price / 100, quantity: 1 }],
            },
          });
        }
        window.location.href = '/cart/' + currentVariant.id + ':1';
      }
      root.querySelectorAll('[data-pp-buy-now]').forEach(function (btn) {
        btn.addEventListener('click', function () { buyNow(btn); });
      });
    })();
  </script>
</div>

