  }
  #shopify-section-{{ section.id }} .pp__thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .pp__main-image {
    position: relative;
    width: 100%;
    margin-bottom: 1rem;
    aspect-ratio: 2 / 3;
    max-width: 100%;
    overflow: hidden;
    border-radius: 1.5rem;
    background: var(--pp-card);
    box-shadow: 0 10px 30px rgba(15, 20, 38, 0.08);
    touch-action: pan-y;
    cursor: zoom-in;
    user-select: none;
    -webkit-user-select: none;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pp__main-image {
      grid-column: 2;
      grid-row: 1;
      margin-bottom: 0;
      justify-self: center;
      /* Explicit width is REQUIRED here: justify-self:center makes this grid
       * item content-sized, and its only child is position:absolute, which
       * contributes zero intrinsic width — without this the box collapses to
       * 0x0 and the image disappears. Matches .product-gallery-main in app.css. */
      width: clamp(400px, calc(66.667vh - 106.667px), 546.667px);
      max-width: 100%;
    }
  }
  #shopify-section-{{ section.id }} .pp__main-image img,
  #shopify-section-{{ section.id }} .pp__main-image .pp__placeholder-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .pp__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pp__dots { display: none; }
  }
  #shopify-section-{{ section.id }} .pp__dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--pp-fg) 20%, transparent);
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: all 200ms ease;
  }
  #shopify-section-{{ section.id }} .pp__dot.is-active {
    width: 1.5rem;
    background: var(--pp-primary);
  }

  /* ---------- wishlist heart ---------- */
  #shopify-section-{{ section.id }} .pp__wishlist {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    color: var(--pp-accent);
    cursor: pointer;
    transition: transform 300ms ease;
  }
  #shopify-section-{{ section.id }} .pp__wishlist:hover { transform: scale(1.1); }
  #shopify-section-{{ section.id }} .pp__wishlist svg {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    transition: fill 200ms ease;
  }
  #shopify-section-{{ section.id }} .pp__wishlist.is-active svg { fill: currentColor; }
  #shopify-section-{{ section.id }} .pp__wishlist--floating {
    top: auto;
    bottom: 5.5rem;
    height: 3rem;
    width: 3rem;
  }
  @media (min-width: 640px) {
    #shopify-section-{{ section.id }} .pp__wishlist--floating { bottom: auto; top: 1rem; }
  }
</style>
