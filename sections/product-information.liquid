    color: var(--pp-fg);
  }
  #shopify-section-{{ section.id }} .pp__accordion-trigger svg {
    width: 1.25rem;
    height: 1.25rem;
    color: color-mix(in srgb, var(--pp-fg) 60%, transparent);
    transition: transform 300ms ease;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .pp__accordion-trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} .pp__accordion-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 300ms ease;
  }
  #shopify-section-{{ section.id }} .pp__accordion-panel p {
    padding-bottom: 1.25rem;
