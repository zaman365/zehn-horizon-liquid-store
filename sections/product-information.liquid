  #shopify-section-{{ section.id }} .pp__viewer-bag:hover { transform: scale(1.1); }
  #shopify-section-{{ section.id }} .pp__viewer-bag svg { width: 1.75rem; height: 1.75rem; }
  #shopify-section-{{ section.id }} .pp__viewer-close {
    position: fixed;
    top: 0.125rem;
    right: 0.125rem;
    z-index: 30;
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    background: none;
