  #shopify-section-{{ section.id }} .pp__modal-close:hover { background: color-mix(in srgb, var(--pp-card) 60%, transparent); }
  #shopify-section-{{ section.id }} .pp__modal-close svg { width: 1.5rem; height: 1.5rem; }
  #shopify-section-{{ section.id }} .pp__modal-body {
    overflow-y: auto;
