  }
  #shopify-section-{{ section.id }} .pp__thumb-nav:hover { color: var(--pp-fg); }
  #shopify-section-{{ section.id }} .pp__thumb-nav--up { margin-bottom: 0.25rem; }
  #shopify-section-{{ section.id }} .pp__thumb-nav--down { margin-top: 0.25rem; }
  #shopify-section-{{ section.id }} .pp__thumb-rail {
