    color: var(--pp-fg);
  }
  #shopify-section-{{ section.id }} .pp__sg-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .pp__sg-grid { grid-template-columns: repeat(2, 1fr); }
  }
  #shopify-section-{{ section.id }} .pp__sg-grid h4 { margin: 0 0 0.25rem; font-weight: 500; color: var(--pp-fg); }
  #shopify-section-{{ section.id }} .pp__sg-grid p { margin: 0; font-size: 0.875rem; color: color-mix(in srgb, var(--pp-fg) 70%, transparent); }
  #shopify-section-{{ section.id }} .pp__sg-table-wrap { overflow-x: auto; }
  #shopify-section-{{ section.id }} .pp__sg-table { width: 100%; border-collapse: collapse; }
  #shopify-section-{{ section.id }} .pp__sg-table th,
  #shopify-section-{{ section.id }} .pp__sg-table td {
    border: 1px solid color-mix(in srgb, var(--pp-border) 50%, transparent);
    padding: 0.75rem 1rem;
    text-align: left;
    color: color-mix(in srgb, var(--pp-fg) 70%, transparent);
  }
  #shopify-section-{{ section.id }} .pp__sg-table th { background: var(--pp-card); font-weight: 500; color: var(--pp-fg); }
  #shopify-section-{{ section.id }} .pp__sg-table tr:nth-child(even) td { background: color-mix(in srgb, var(--pp-card) 30%, transparent); }
  #shopify-section-{{ section.id }} .pp__sg-tips {
    background: color-mix(in srgb, var(--pp-card) 30%, transparent);
    border-radius: 0.5rem;
    padding: 1.5rem;
  }
  #shopify-section-{{ section.id }} .pp__sg-tips h3 { margin-top: 0; }
  #shopify-section-{{ section.id }} .pp__sg-tips ul { margin: 0; padding-left: 1.25rem; font-size: 0.875rem; color: color-mix(in srgb, var(--pp-fg) 70%, transparent); }
  #shopify-section-{{ section.id }} .pp__sg-tips li { margin-bottom: 0.5rem; }

  /* ---------- fullscreen image viewer ---------- */
  #shopify-section-{{ section.id }} .pp__viewer {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(24px);
    cursor: zoom-out;
  }
  #shopify-section-{{ section.id }} .pp__viewer.is-open { display: flex; }
  #shopify-section-{{ section.id }} .pp__viewer-frame {
    position: relative;
    width: min(92vw, 60vh);
    height: min(92vh, 138vh);
    max-height: 92vh;
    aspect-ratio: 2 / 3;
    cursor: default;
    touch-action: pan-y;
  }
  #shopify-section-{{ section.id }} .pp__viewer-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }
  #shopify-section-{{ section.id }} .pp__viewer-nav {
    position: absolute;
    top: 50%;
    z-index: 20;
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    transform: translateY(-50%);
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    color: #fff;
    filter: drop-shadow(0 1px 1px rgba(0,0,0,0.4));
    cursor: pointer;
    transition: transform 200ms ease;
  }
  #shopify-section-{{ section.id }} .pp__viewer-nav:hover { transform: translateY(-50%) scale(1.1); }
  #shopify-section-{{ section.id }} .pp__viewer-nav--prev { left: 0.5rem; }
  #shopify-section-{{ section.id }} .pp__viewer-nav--next { right: 0.5rem; }
  #shopify-section-{{ section.id }} .pp__viewer-nav svg { width: 1.5rem; height: 1.5rem; }
  #shopify-section-{{ section.id }} .pp__viewer-bag {
    position: absolute;
    bottom: 1.5rem;
    right: 1rem;
    z-index: 20;
    display: flex;
    height: 3rem;
    width: 3rem;
    align-items: center;
    justify-content: center;
    background: none;
