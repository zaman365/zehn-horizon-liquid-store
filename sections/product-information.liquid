  #shopify-section-{{ section.id }} .pp__thumb-rail::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .pp__thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--pp-card);
    border: 0;
    padding: 0;
