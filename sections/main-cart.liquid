

{% liquid
  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

{% capture cart_page_more_blocks_content %}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{% endcapture %}

{% capture zehn_cart_page_header %}
  <header class="zehn-cart-page__header">
    <div class="zehn-cart-page__heading-row">
      <h1>Warenkorb</h1>
      <span class="zehn-cart-page__count">{{ cart.item_count }} Artikel</span>
    </div>
    <p>Sicher bezahlen · 30 Tage Rückgabe</p>
  </header>
{% endcapture %}

{% capture cart_items_children %}
  <template id="empty-cart-template">
    <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
    <div
      class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
    >
      {{ zehn_cart_page_header }}
      <div
        class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        <div class="cart-page__title">
          {%- content_for 'block', id: 'cart-page-title-empty', type: '_cart-title', force_empty: true %}
        </div>
        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items-empty', type: '_cart-products', force_empty: true %}
        </div>
        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </template>

  <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
  >
    {{ zehn_cart_page_header }}
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <div class="cart-page__title">
        {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' %}
      </div>

      <div class="cart-page__items">
        {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}
      </div>

      {%- unless cart.empty? -%}
        <div class="cart-page__summary">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endunless -%}

      {{ cart_page_more_blocks_content }}
    </div>
  </div>
{% endcapture %}
{% render 'cart-items-component', children: cart_items_children, section_id: section.id %}

{% stylesheet %}
  .zehn-cart-page__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    max-width: 1440px;
    margin-inline: auto;
    margin-block-end: 24px;
  }

  .zehn-cart-page__heading-row { display: flex; align-items: baseline; gap: 12px; }
  .zehn-cart-page__header h1 {
    margin: 0;
    color: var(--zehn-indigo, #0f1426);
    font-family: var(--font-heading--family);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .zehn-cart-page__count,
  .zehn-cart-page__header > p { margin: 0; color: rgb(15 20 38 / 56%); font-size: 14px; }

  .cart-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--padding-5xl);
    max-width: 1440px;
    margin-inline: auto;
  }

  .cart-page__title { display: none; }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cart-page--empty .cart-page__title,
  .cart-page--empty .cart-page__more-blocks {
    margin-top: var(--margin-6xl);
  }

  .cart-page__more-blocks {
    width: 100%;
  }

  .cart-page--empty .cart-title {
    text-align: center;
  }

  .cart-page__main {
    grid-column: 1;
  }

  .cart-page__summary {
    padding-top: var(--padding-xl);
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  .cart-page .cart-items__table,
  .cart-page .cart-items__table tbody { display: grid; gap: 16px; }

  .cart-page .cart-items__table-row,
  .cart-page .cart-items--dividers .cart-items__table-row,
  .cart-page .cart-items--dividers .cart-items__table-row:last-of-type {
    grid-template-columns: 132px minmax(0, 1fr) auto;
    grid-template-areas: 'media details price' 'media quantity price' 'media error error';
    gap: 0 24px;
    margin: 0;
    padding: 20px;
    border: 1px solid rgb(15 20 38 / 10%);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 28px rgb(15 20 38 / 4%);
  }

  .cart-page .cart-items__media-container,
  .cart-page .cart-items__media-image { border-radius: 12px; }
  .cart-page .cart-items__title {
    color: var(--zehn-indigo, #0f1426);
    font-family: var(--font-heading--family);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.25;
  }
  .cart-page .cart-items__variants-wrapper,
  .cart-page .cart-items__unit-price-wrapper { color: rgb(15 20 38 / 58%); }
  .cart-page .cart-items__quantity .quantity-selector {
    min-height: 42px;
    overflow: hidden;
    border: 1px solid rgb(15 20 38 / 18%);
    border-radius: 999px;
    background: #fff;
  }
  .cart-page .cart-items__quantity .quantity-selector button { width: 40px; height: 40px; }
  .cart-page .cart-items__remove { border-radius: 999px; color: rgb(15 20 38 / 55%); }
  .cart-page .cart-items__remove:hover { color: var(--zehn-signal, #ff5a1f); background: rgb(255 90 31 / 10%); }
  .cart-page .cart-items__price {
    color: var(--zehn-indigo, #0f1426);
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 600;
  }
  .cart-page .cart-summary {
    overflow: hidden;
    border: 1px solid rgb(15 20 38 / 10%);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 28px rgb(15 20 38 / 4%);
  }
  .cart-page .cart-summary__inner { align-items: stretch; gap: 20px; padding: 24px; }
  .cart-page .cart-totals__tax-note { display: none; }
  .cart-page .cart__checkout-button {
    min-height: 52px;
    border-radius: 999px;
    background: var(--zehn-indigo, #0f1426);
    color: #fff;
    font-weight: 600;
  }
  body:has(.cart-page--empty) .ui-test-product-list { display: none; }

  @media screen and (min-width: 750px) {
    .cart-page {
      grid-template-columns: minmax(0, 1fr) minmax(330px, 380px);
      grid-template-rows: min-content min-content 1fr;
      gap: 32px;
    }

    .cart-page__summary {
      display: grid;
      height: 100%;
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: stretch;
      grid-template-rows: subgrid;
      padding-top: 0;

      /* needed to support blurred effect from hero section */
      position: relative;
    }

  }

  @media screen and (max-width: 749px) {
    .zehn-cart-page__header { align-items: flex-start; flex-direction: column; gap: 8px; margin-block-end: 20px; }
    .cart-page .cart-items__table-row,
    .cart-page .cart-items--dividers .cart-items__table-row,
    .cart-page .cart-items--dividers .cart-items__table-row:last-of-type {
      grid-template-columns: 96px minmax(0, 1fr);
      grid-template-areas: 'media details' 'media price' 'media quantity' 'error error';
      gap: 10px 16px;
      padding: 16px;
    }
    .cart-page .cart-items__price { text-align: start; }
    .cart-page .cart-summary__inner { padding: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
