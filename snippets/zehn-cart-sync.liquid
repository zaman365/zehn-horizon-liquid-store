{%- comment -%}
  ============================================================================
  ZEHN cart sync — v2

  Install: snippets/zehn-cart-sync.liquid
  Render EARLY in layout/theme.liquid, inside <head>:

    <head>
      <meta charset="utf-8">
      {% render 'zehn-cart-sync' %}

  Position matters. If a theme script copies window.fetch into a variable
  before this runs, the wrapper below never sees the request.

  What changed from v1: this no longer depends on the header listening to an
  event. It reads /cart.js and writes the badge itself, so the count is right
  even if the header's own script failed, or a second header is on the page.

  It syncs on: page load, any successful /cart/add|change|update|clear through
  fetch or XHR, any click on an add-to-cart control, tab refocus, and cached
  back-navigation. Cheap — /cart.js is a small uncached JSON response.
  ============================================================================
{%- endcomment -%}

<script>
  (function () {
    if (window.__zehnCartSyncReady) return;
    window.__zehnCartSyncReady = true;

    var CART_MUTATION = /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/;
    var ADD_TO_CART_SELECTOR = [
      '[name="add"]',
      '[data-add-to-cart]',
      '[data-zehn-add-to-cart]',
      '.product-form__submit',
      '.add-to-cart',
      'form[action*="/cart/add"] button',
      'form[action*="/cart/add"] [type="submit"]',
    ].join(',');

    var CART_URL = {{ routes.cart_url | json }} + '.js';

    var syncTimer = null;
    var lastCount = null;

    /* ------------------------------------------------------------------
       Paint the badge directly. Mirrors the header section's own logic:
       data-zh-count drives visibility and the accent colour via CSS, the
       inner element carries the number.
       ------------------------------------------------------------------ */
    function paint(count) {
      document.querySelectorAll('[data-zh-cart]').forEach(function (el) {
        el.setAttribute('data-zh-count', String(count));
        var badge = el.querySelector('[data-zh-cart-count]');
        if (badge) badge.textContent = count > 9 ? '9+' : String(count);
      });
    }

    function sync(options) {
      var force = options && options.force;

      return fetch(CART_URL, {headers: {Accept: 'application/json'}, cache: 'no-store'})
        .then(function (res) {
          return res.json();
        })
        .then(function (cart) {
          var count = cart.item_count || 0;
          if (!force && count === lastCount) return;
          lastCount = count;

          paint(count);

          // Still emit the event — the drawer and anything else can react.
          document.dispatchEvent(
            new CustomEvent('zehn:cart:updated', {
              bubbles: true,
              detail: {count: count, cart: cart},
            }),
          );

          if (window.ZehnCartDrawer && typeof window.ZehnCartDrawer.refresh === 'function') {
            return window.ZehnCartDrawer.refresh();
          }
        })
        .catch(function () {});
    }

    function scheduleSync(delay) {
      if (syncTimer) clearTimeout(syncTimer);
      syncTimer = setTimeout(function () {
        sync();
      }, typeof delay === 'number' ? delay : 120);
    }

    /* A click can't tell us when the request finishes, so check a few times. */
    function syncRepeatedly() {
      [400, 1200, 2500].forEach(function (delay) {
        setTimeout(function () {
          sync();
        }, delay);
      });
    }

    function isCartMutation(url) {
      return typeof url === 'string' && CART_MUTATION.test(url);
    }

    /* The drawer asks for section HTML in its own requests — it self-updates. */
    function isDrawerRequest(init) {
      if (!init || typeof init.body !== 'string') return false;
      return init.body.indexOf('"sections"') !== -1;
    }

    /* ---------- fetch ---------- */
    var nativeFetch = window.fetch;
    if (typeof nativeFetch === 'function') {
      window.fetch = function (input, init) {
        var url = input && input.url ? input.url : String(input);
        var watch = isCartMutation(url) && !isDrawerRequest(init);
        var request = nativeFetch.apply(this, arguments);

        if (watch) {
          request
            .then(function (response) {
              if (response && response.ok) scheduleSync();
              return response;
            })
            .catch(function () {});
        }

        return request;
      };
    }

    /* ---------- XMLHttpRequest ---------- */
    var nativeOpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function (method, url) {
      this.__zehnWatch = isCartMutation(url);
      return nativeOpen.apply(this, arguments);
    };

    var nativeSend = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.send = function () {
      if (this.__zehnWatch) {
        this.addEventListener('load', function () {
          if (this.status >= 200 && this.status < 300) scheduleSync();
        });
      }
      return nativeSend.apply(this, arguments);
    };

    /* ---------- clicks on anything that looks like add-to-cart ---------- */
    document.addEventListener(
      'click',
      function (event) {
        var target = event.target;
        if (!target || typeof target.closest !== 'function') return;
        if (target.closest(ADD_TO_CART_SELECTOR)) syncRepeatedly();
      },
      true,
    );

    /* Covers forms submitted by keyboard rather than a click. */
    document.addEventListener(
      'submit',
      function (event) {
        var form = event.target;
        if (!form || !form.action) return;
        if (form.action.indexOf('/cart/add') !== -1) syncRepeatedly();
      },
      true,
    );

    /* ---------- events other themes and apps emit ---------- */
    ['cart:refresh', 'cart:updated', 'shopify:cart:updated', 'zehn:cart:sync'].forEach(
      function (name) {
        document.addEventListener(name, function () {
          scheduleSync();
        });
      },
    );

    /* ---------- load, refocus, cached back-navigation ---------- */
    function initialSync() {
      sync({force: true});
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialSync);
    } else {
      initialSync();
    }

    window.addEventListener('pageshow', function (event) {
      if (event.persisted) sync({force: true});
    });

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) scheduleSync(300);
    });

    window.ZehnCartSync = function () {
      return sync({force: true});
    };
  })();
</script>
